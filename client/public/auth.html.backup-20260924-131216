<script>
(() => {
  'use strict';

  /* ── Configuration ───────────────────────────────────────────────────────
     credentialField: server/routes/auth.ts loginSchema reads `credential` (username OR email,
     resolved by "@"). Verify on the current tree:  sed -n '66,80p' server/routes/auth.ts
     storageKey: must match the persist key useAuthStore reads, or the app won't see the session:
                 grep -rn "persist(" client/src --include=*.ts | grep -i auth                    */
  const DEFAULTS = {
    loginUrl: '/api/auth/login',
    healthUrl: '/api/health',
    credentialField: 'credential',
    requestTimeoutMs: 12000,
    probeTimeoutMs: 4000,
    probeIntervalMs: 15000,
    storageKey: 'r3.auth',
    redirectTo: '/instrument',
    routes: { forgot: '/forgot-password', plans: '/pricing', fullAuth: '/auth', home: '/' },
    authNode: '',            // e.g. your Railway region; blank = this page's hostname
    transportLabel: 'TLS',   // shown under ENCRYPTION on https only
    engineBufferSize: 512,
    version: 'v4.2.1',
    edition: 'Founder’s Edition'
  };
  const user = (typeof window.R3_AUTH_CONFIG === 'object' && window.R3_AUTH_CONFIG) || {};
  const CFG = Object.freeze({ ...DEFAULTS, ...user, routes: Object.freeze({ ...DEFAULTS.routes, ...(user.routes || {}) }) });

  const $ = (id) => document.getElementById(id);
  const qs = new URLSearchParams(location.search);
  const REFERENCE = location.hash === '#reference' || qs.has('reference');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const form = $('authForm'), credEl = $('credential'), passEl = $('password'), rememberEl = $('remember');
  const revealBtn = $('reveal'), submitBtn = $('submitBtn'), submitLabel = $('submitLabel');
  const alertEl = $('formAlert'), announcer = $('announcer');
  const meter = $('meter'), meterLabel = $('meterLabel'), meterSr = $('meterSr');
  const meterSegs = [...meter.querySelectorAll('.meter-track i')];
  const segWeights = meterSegs.map((s) => parseFloat(s.style.flex) || 1);
  const segTotal = segWeights.reduce((a, b) => a + b, 0);

  /* ── Static labels & routes ─────────────────────────────────────────────── */
  $('versionLabel').textContent = CFG.version;
  $('buildLabel').textContent = 'R3 ' + CFG.version;
  $('editionLabel').textContent = CFG.edition;
  $('tBuf').textContent = String(CFG.engineBufferSize);
  $('plansLink').href = CFG.routes.plans;
  $('fullAuthLink').href = CFG.routes.fullAuth;
  $('homeLink').href = CFG.routes.home;

  /* ── Request trace id (non-secret; correlates client ↔ server logs) ─────── */
  function randomHex(bytes) {
    const a = new Uint8Array(bytes);
    crypto.getRandomValues(a);
    return Array.from(a, (b) => b.toString(16).padStart(2, '0')).join('');
  }
  const traceId = REFERENCE ? '7f3a9c2e91d04b6a' : randomHex(8);
  const sessionEl = $('spSession');
  sessionEl.textContent = traceId.slice(0, 8) + '…';
  sessionEl.title = 'Request trace ID ' + traceId + ' (sent as X-Request-Id; not a credential)';

  /* ── Transport security (truthful: the page cannot see the negotiated cipher) */
  const isHttps = location.protocol === 'https:';
  const isLocal = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
  function renderSecurity() {
    const foot = $('cardFoot'), secText = $('secText'), enc = $('spEnc');
    if (REFERENCE) { enc.textContent = 'AES-256'; foot.dataset.sec = 'tls'; return; }
    if (isHttps) {
      enc.textContent = CFG.transportLabel;
      foot.dataset.sec = 'tls';
    } else {
      enc.textContent = 'None';
      foot.dataset.sec = 'plain';
      secText.innerHTML = '';
      secText.append(isLocal ? 'Local' : 'Not', mkSep(), 'Unencrypted');
    }
  }
  function mkSep() { const i = document.createElement('i'); i.setAttribute('aria-hidden', 'true'); i.textContent = '/'; return i; }

  /* ── Connection status (live health probe) ──────────────────────────────── */
  const net = { state: 'checking', rtt: null, ok: 0, total: 0 };
  function setNet(state) {
    const prev = net.state;
    net.state = state;
    document.body.dataset.net = state;
    const label = { checking: 'Checking', online: 'Online', degraded: 'Degraded', offline: 'Offline' }[state];
    $('nodeState').textContent = label;
    if (prev !== state && (state === 'offline' || (prev === 'offline' && state === 'online'))) announce('Server ' + label.toLowerCase() + '.');
  }
  function renderNet() {
    $('spNode').textContent = CFG.authNode || location.hostname || 'local';
    $('spLatency').textContent = net.rtt == null ? '—' : net.rtt + 'ms';
    $('spIntegrity').textContent = net.total ? (net.ok / net.total * 100).toFixed(1) + '%' : '—';
  }
  function timeoutSignal(ms) {
    if (typeof AbortSignal !== 'undefined' && AbortSignal.timeout) return { signal: AbortSignal.timeout(ms), clear() {} };
    const c = new AbortController(); const t = setTimeout(() => c.abort(), ms);
    return { signal: c.signal, clear() { clearTimeout(t); } };
  }
  let probeTimer = 0;
  async function probe() {
    clearTimeout(probeTimer);
    if (!CFG.healthUrl || document.hidden) return;
    const t = timeoutSignal(CFG.probeTimeoutMs);
    const t0 = performance.now();
    net.total++;
    try {
      const res = await fetch(CFG.healthUrl, { method: 'GET', cache: 'no-store', credentials: 'same-origin', headers: { 'X-Request-Id': traceId }, signal: t.signal });
      res.body && res.body.cancel().catch(() => {});
      net.rtt = Math.round(performance.now() - t0);
      if (res.status >= 500) setNet('degraded'); else { net.ok++; setNet('online'); }
    } catch (_) {
      net.rtt = null;
      setNet('offline');
    } finally {
      t.clear();
      renderNet();
      probeTimer = setTimeout(probe, CFG.probeIntervalMs);
    }
  }

  /* ── Password reveal + strength (meter only reads while revealed) ───────── */
  const WORDS = ['password', 'passwort', 'qwerty', 'admin', 'letmein', 'welcome', 'login', 'master', 'dragon', 'monkey', 'shadow', 'sunshine', 'princess', 'football', 'baseball', 'iloveyou', 'secret', 'native', 'music', 'studio', 'beats'];
  const SHORT = ['dev', 'test', 'user', 'pass', 'abc', 'qwe', 'r3', 'root', 'demo'];
  function deleet(s) { return s.toLowerCase().replace(/[@4]/g, 'a').replace(/0/g, 'o').replace(/[1!|]/g, 'i').replace(/3/g, 'e').replace(/[5$]/g, 's').replace(/7/g, 't').replace(/(.)\1{2,}/g, '$1$1'); }
  function estimateBits(pw) {
    if (!pw) return 0;
    let bits = 0;
    for (const seg of pw.match(/[A-Za-z]+|[0-9]+|[^A-Za-z0-9]+/g) || []) {
      if (/^[A-Za-z]+$/.test(seg)) {
        const d = deleet(seg), mixed = /[a-z]/.test(seg) && /[A-Z]/.test(seg);
        const word = WORDS.find((w) => d.includes(w));
        if (word) bits += 11 + Math.max(0, d.length - word.length) * 4.7 + (mixed ? 1 : 0);
        else if (SHORT.includes(d)) bits += 6;
        else bits += seg.length * Math.log2(mixed ? 52 : 26);
      } else if (/^[0-9]+$/.test(seg)) {
        const seq = '01234567890', rev = '09876543210';
        const trivial = seq.includes(seg) || rev.includes(seg) || /^(\d)\1+$/.test(seg) || /^(19|20)\d\d$/.test(seg);
        bits += trivial ? 3.5 : seg.length * 3.32;
      } else {
        bits += Math.min(seg.length, 3) * 5;
      }
    }
    if (pw.length < 8) bits = Math.min(bits, 20);
    return bits;
  }
  function renderStrength() {
    const revealed = passEl.type === 'text';
    const bits = revealed ? estimateBits(passEl.value) : 0;
    const level = !revealed || !passEl.value ? '' : bits < 28 ? 'weak' : bits < 45 ? 'fair' : bits < 60 ? 'good' : 'strong';
    const filled = Math.min(1, bits / 72) * segTotal;
    let start = 0;
    meterSegs.forEach((seg, i) => {
      const f = Math.max(0, Math.min(1, (filled - start) / segWeights[i]));
      seg.style.setProperty('--f', f.toFixed(3));
      start += segWeights[i];
    });
    meter.dataset.level = level;
    meterLabel.textContent = level;
    meterSr.textContent = level ? 'Password strength: ' + level : '';
  }
  function setReveal(on) {
    passEl.type = on ? 'text' : 'password';
    revealBtn.setAttribute('aria-pressed', String(on));
    revealBtn.setAttribute('aria-label', on ? 'Hide password' : 'Show password');
    renderStrength();
  }
  revealBtn.addEventListener('click', () => setReveal(passEl.type === 'password'));
  passEl.addEventListener('input', renderStrength);
  const capsHint = $('capsHint');
  function caps(e) { if (e.getModifierState) capsHint.hidden = !e.getModifierState('CapsLock'); }
  passEl.addEventListener('keydown', caps);
  passEl.addEventListener('keyup', caps);
  passEl.addEventListener('blur', () => { capsHint.hidden = true; });

  /* ── Errors ─────────────────────────────────────────────────────────────── */
  function announce(msg) { announcer.textContent = ''; requestAnimationFrame(() => { announcer.textContent = msg; }); }
  function fieldError(input, msg) {
    const out = $(input.id + 'Error');
    out.textContent = msg || '';
    out.hidden = !msg;
    if (msg) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid');
  }
  function showAlert(msg, tone) {
    alertEl.textContent = msg || '';
    alertEl.hidden = !msg;
    if (tone) alertEl.dataset.tone = tone; else delete alertEl.dataset.tone;
  }
  [credEl, passEl].forEach((el) => el.addEventListener('input', () => { if (el.getAttribute('aria-invalid')) fieldError(el, ''); }));

  /* ── Submit state machine: idle → busy → (done | idle+error) ─────────────── */
  let inFlight = false;
  function setState(state) {
    submitBtn.dataset.state = state;
    const busy = state === 'busy' || state === 'done';
    submitBtn.setAttribute('aria-disabled', String(busy));
    form.setAttribute('aria-busy', String(state === 'busy'));
    credEl.readOnly = busy;
    passEl.readOnly = busy;
    submitLabel.textContent = state === 'busy' ? 'Authenticating…' : state === 'done' ? 'Authenticated' : 'Authenticate';
  }
  function safeDestination() {
    const raw = qs.get('next') || CFG.redirectTo || '/';
    try {
      const u = new URL(raw, location.origin);
      if (u.origin !== location.origin) return '/';
      return u.pathname + u.search + u.hash;
    } catch (_) { return '/'; }
  }
  async function readJson(res) {
    if (!(res.headers.get('content-type') || '').includes('json')) return null;
    try { return await res.json(); } catch (_) { return null; }
  }
  function persistSession(data) {
    // Write plain JWT to localStorage only (no sessionStorage variant).
    // The "Remember me" checkbox is hidden for now; session-only can be added later.
    localStorage.setItem(CFG.storageKey, data.token);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (inFlight || REFERENCE || submitBtn.dataset.state === 'done') return;
    showAlert('');
    const credential = credEl.value.trim();
    const password = passEl.value;
    fieldError(credEl, credential ? '' : 'Enter your email or username.');
    fieldError(passEl, password ? '' : 'Enter your password.');
    if (!credential || !password) { (credential ? passEl : credEl).focus(); return; }

    inFlight = true;
    setState('busy');
    announce('Signing in…');
    const t = timeoutSignal(CFG.requestTimeoutMs);
    let ok = false;
    try {
      const res = await fetch(CFG.loginUrl, {
        method: 'POST',
        cache: 'no-store',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Request-Id': traceId },
        body: JSON.stringify({ [CFG.credentialField]: credential, password }),
        signal: t.signal
      });
      const data = await readJson(res);
      if (res.ok) {
        if (!data || typeof data.token !== 'string' || !/^[\w-]+\.[\w-]+\.[\w-]+$/.test(data.token)) {
          showAlert('Sign-in responded without a session token. Check the server’s login response shape ({ token, user }).');
        } else {
          try { persistSession(data); } catch (_) { showAlert('Signed in, but this browser blocked storage, so the session can’t be kept. Allow site storage and try again.'); return; }
          ok = true;
          passEl.value = '';
          setState('done');
          announce('Signed in.');
          window.dispatchEvent(new CustomEvent('r3:authenticated', { detail: { user: data.user || null } }));
          if (CFG.redirectTo !== null) setTimeout(() => location.assign(safeDestination()), 350);
        }
        return;
      }
      if (res.status === 401 || res.status === 403) {
        showAlert('That email/username and password don’t match. Check both and try again.');
        passEl.value = '';
        renderStrength();
        passEl.focus();
      } else if (res.status === 400) {
        showAlert('Enter your email or username and your password.');
      } else if (res.status === 429) {
        const wait = parseInt(res.headers.get('retry-after') || '', 10);
        showAlert('Too many sign-in attempts. ' + (wait > 0 ? 'Try again in ' + wait + ' seconds.' : 'Wait a minute, then try again.'));
      } else if (res.status === 404 || res.status === 405) {
        showAlert('Sign-in isn’t available at ' + CFG.loginUrl + ' (HTTP ' + res.status + '). Check the loginUrl setting.');
      } else if (res.status >= 500) {
        showAlert('The server couldn’t complete sign-in (HTTP ' + res.status + '). Try again in a moment.');
      } else {
        showAlert('Sign-in failed (HTTP ' + res.status + ').');
      }
    } catch (err) {
      if (t.signal.aborted) {
        showAlert('The R3 server didn’t respond within ' + Math.round(CFG.requestTimeoutMs / 1000) + ' seconds. Check that the API is running, then try again.');
        setNet('degraded');
      } else {
        showAlert('Can’t reach the R3 server. Check your connection and that the API is running.');
        setNet('offline');
      }
    } finally {
      t.clear();
      inFlight = false;
      if (!ok) { setState('idle'); if (!alertEl.hidden) announce(alertEl.textContent); }
    }
  });
  submitBtn.addEventListener('click', (e) => { if (submitBtn.getAttribute('aria-disabled') === 'true') e.preventDefault(); });

  /* ── Canvases: background world + signal preview ───────────────────────── */
  const bg = $('bg'), bctx = bg.getContext('2d', { alpha: false });
  const sig = $('sig'), sctx = sig.getContext('2d');
  const layer = document.createElement('canvas'), lctx = layer.getContext('2d');
  let W = 0, H = 0, DPR = 1, SW = 0, SH = 0, SDPR = 1;
  let gradL, gradR, gradS1, gradS2, gradBarsL, gradBarsR;

  function rng(seed) { let s = seed >>> 0; return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296); }
  const barSeeds = (() => { const r = rng(784512); return Array.from({ length: 96 }, () => r()); })();

  function paintStatic() {
    const c = lctx;
    c.setTransform(DPR, 0, 0, DPR, 0, 0);
    let g = c.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#040909'); g.addColorStop(0.3, '#07110e'); g.addColorStop(0.45, '#0c1c15'); g.addColorStop(0.64, '#0a1712'); g.addColorStop(1, '#0a1511');
    c.fillStyle = g; c.fillRect(0, 0, W, H);
    const haze = (x, y, r, col) => { const h = c.createRadialGradient(x, y, 0, x, y, r); h.addColorStop(0, col); h.addColorStop(1, 'rgba(0,0,0,0)'); c.fillStyle = h; c.fillRect(0, 0, W, H); };
    haze(W * 0.13, H * 0.44, W * 0.24, 'rgba(20,95,105,.34)');
    haze(W * 0.87, H * 0.5, W * 0.22, 'rgba(80,55,150,.32)');
    haze(W * 0.84, H * 0.62, W * 0.14, 'rgba(90,170,50,.16)');
    haze(W * 0.5, H * 0.5, W * 0.36, 'rgba(45,100,50,.22)');
    haze(W * 0.5, H * 0.1, W * 0.26, 'rgba(120,200,40,.14)');
    haze(W * 0.5, H * 0.95, W * 0.34, 'rgba(130,210,40,.22)');
    // light pillars
    const pillar = (x, y0, y1, w, a) => {
      const cy = (y0 + y1) / 2, hl = (y1 - y0) / 2;
      c.save(); c.globalCompositeOperation = 'lighter'; c.translate(x, cy); c.scale(w / hl, 1);
      const pg = c.createRadialGradient(0, 0, 0, 0, 0, hl);
      pg.addColorStop(0, `rgba(190,255,80,${a})`); pg.addColorStop(0.45, `rgba(164,244,34,${a * 0.35})`); pg.addColorStop(1, 'rgba(164,244,34,0)');
      c.fillStyle = pg; c.fillRect(-hl, -hl, hl * 2, hl * 2); c.restore();
    };
    pillar(W * 0.173, H * 0.12, H * 0.66, 16, 0.22);
    pillar(W * 0.786, H * 0.14, H * 0.62, 20, 0.16);
    pillar(W * 0.93, H * 0.25, H * 0.66, 26, 0.12);
    pillar(W * 0.07, H * 0.3, H * 0.7, 30, 0.08);
    // bokeh
    const bokeh = [[0.175, 0.22, 3], [0.192, 0.23, 2], [0.162, 0.21, 1.6], [0.79, 0.2, 2.2], [0.915, 0.31, 2.6], [0.97, 0.61, 2], [0.03, 0.66, 2], [0.24, 0.58, 1.5], [0.69, 0.66, 1.4], [0.84, 0.7, 1.8]];
    c.globalCompositeOperation = 'lighter';
    for (const [x, y, r] of bokeh) { const b = c.createRadialGradient(W * x, H * y, 0, W * x, H * y, r * 4); b.addColorStop(0, 'rgba(200,255,90,.85)'); b.addColorStop(0.25, 'rgba(164,244,34,.35)'); b.addColorStop(1, 'rgba(164,244,34,0)'); c.fillStyle = b; c.fillRect(W * x - r * 4, H * y - r * 4, r * 8, r * 8); }
    c.globalCompositeOperation = 'source-over';
    // reflective floor with perspective grid
    const hy = H * 0.655, vx = W * 0.5, vy = H * 0.36;
    g = c.createLinearGradient(0, hy, 0, H);
    g.addColorStop(0, 'rgba(60,110,70,.10)'); g.addColorStop(1, 'rgba(20,40,30,.18)');
    c.fillStyle = g; c.fillRect(0, hy, W, H - hy);
    c.lineWidth = 1;
    for (let i = -16; i <= 16; i++) {
      const xb = vx + i * W * 0.08;
      const t = (hy - vy) / (H - vy);
      const xh = vx + (xb - vx) * t;
      const lg = c.createLinearGradient(0, hy, 0, H);
      lg.addColorStop(0, 'rgba(130,210,190,0)'); lg.addColorStop(1, 'rgba(130,210,190,.14)');
      c.strokeStyle = lg; c.beginPath(); c.moveTo(xh, hy); c.lineTo(xb, H); c.stroke();
    }
    for (let k = 1; k <= 10; k++) {
      const y = hy + (H - hy) * Math.pow(k / 10, 1.7);
      c.strokeStyle = `rgba(140,220,170,${0.03 + 0.1 * k / 10})`;
      c.beginPath(); c.moveTo(0, y); c.lineTo(W, y); c.stroke();
    }
    const hz = c.createLinearGradient(0, 0, W, 0);
    hz.addColorStop(0, 'rgba(120,230,160,0)'); hz.addColorStop(0.5, 'rgba(164,244,34,.16)'); hz.addColorStop(1, 'rgba(120,230,160,0)');
    c.fillStyle = hz; c.fillRect(0, hy - 0.5, W, 1);
    c.globalCompositeOperation = 'lighter';
    for (const [x, w, a] of [[0.173, 10, 0.16], [0.786, 12, 0.12], [0.93, 16, 0.09], [0.26, 6, 0.1], [0.74, 6, 0.1]]) {
      const rg = c.createLinearGradient(0, hy, 0, H);
      rg.addColorStop(0, `rgba(170,255,70,${a})`); rg.addColorStop(1, 'rgba(164,244,34,0)');
      c.fillStyle = rg; c.fillRect(W * x - w / 2, hy, w, H - hy);
    }
    c.globalCompositeOperation = 'source-over';
    // vignette
    g = c.createRadialGradient(W / 2, H * 0.48, Math.min(W, H) * 0.35, W / 2, H * 0.5, Math.max(W, H) * 0.75);
    g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, 'rgba(0,0,0,.28)');
    c.fillStyle = g; c.fillRect(0, 0, W, H);

    const mk = (x0, x1, stops) => { const gr = bctx.createLinearGradient(x0, 0, x1, 0); stops.forEach(([o, col]) => gr.addColorStop(o, col)); return gr; };
    gradL = mk(0, W * 0.27, [[0, '#23e4ff'], [0.45, '#35a8ff'], [0.75, '#6f6bff'], [1, '#b04dff']]);
    gradR = mk(W * 0.735, W, [[0, '#2fd9ff'], [0.35, '#5a7dff'], [0.62, '#b24dff'], [0.85, '#e04bfa'], [1, '#a4f422']]);
    gradBarsL = mk(0, W * 0.2, [[0, '#1bd8ff'], [1, '#3b7dff']]);
    gradBarsR = mk(W * 0.85, W, [[0, '#6de35a'], [1, '#a4f422']]);
  }

  function ribbon(c, x0, x1, cy, amp, t, grad, dir, strands, mirrorY) {
    // Twisted particle bundle: centerline wave + per-strand offset rotating along x.
    const span = x1 - x0, step = mirrorY ? 7 : 4;
    c.fillStyle = grad; c.strokeStyle = grad;
    for (let s = 0; s < strands; s++) {
      const th = (s / strands) * Math.PI * 2, core = s % 7 === 0, rf = core ? 1 : 0.22 + 0.78 * ((s * 0.618034) % 1);
      c.globalAlpha = mirrorY ? 0.07 : core ? 0.95 : 0.62;
      if (core) { c.lineWidth = 1.2; c.beginPath(); }
      for (let x = x0; x <= x1; x += core ? 3 : step) {
        let u = (x - x0) / span; if (dir < 0) u = 1 - u;
        const center = cy + amp * Math.sin(Math.PI * 2 * 1.05 * u + t * 0.45) * (0.7 + 0.3 * Math.sin(t * 0.21 + dir));
        const width = amp * (0.35 + 1.05 * (1 - u) * (1 - u));
        let y = center + width * rf * Math.cos(th + Math.PI * 2 * 1.35 * u - t * 0.6) + amp * 0.12 * Math.sin(u * 40 + s + t);
        if (mirrorY) y = 2 * mirrorY - y;
        if (core) { x === x0 ? c.moveTo(x, y) : c.lineTo(x, y); } else c.fillRect(x, y, 1.25, 1.25);
      }
      if (core) {
        c.stroke();
        if (!mirrorY) { c.globalAlpha = 0.07; c.lineWidth = 6; c.stroke(); }
      }
    }
    c.globalAlpha = 1;
  }
  function bars(c, x0, x1, cy, up, down, t, grad, offset) {
    // Spectrum spikes centred on the ribbon (dotted, like the reference particle columns).
    c.fillStyle = grad;
    const n = Math.floor((x1 - x0) / 8);
    for (let i = 0; i < n; i++) {
      const r = barSeeds[(i + offset) % barSeeds.length];
      const k = (0.2 + 0.8 * r * r) * (0.86 + 0.14 * Math.sin(t * 1.3 + i * 0.8));
      const x = x0 + i * 8 + ((r * 4) | 0);
      c.globalAlpha = 0.16 + 0.34 * r;
      for (let y = cy - up * k; y < cy + down * k; y += 3.5) c.fillRect(x, y, 1.1, 1.6);
      c.globalAlpha = 0.9; c.fillRect(x - 0.4, cy - up * k, 2, 2);
    }
    c.globalAlpha = 1;
  }
  function drawBg(t) {
    bctx.setTransform(1, 0, 0, 1, 0, 0);
    bctx.drawImage(layer, 0, 0);
    bctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    bctx.globalCompositeOperation = 'lighter';
    const floorY = H * 0.655, cyL = H * 0.462, cyR = H * 0.475;
    bars(bctx, 0, W * 0.185, cyL, H * 0.21, H * 0.1, t, gradBarsL, 0);
    bars(bctx, W * 0.875, W, cyR, H * 0.19, H * 0.08, t, gradBarsR, 40);
    ribbon(bctx, -10, W * 0.268, cyL, H * 0.04, t, gradL, 1, 36, 0);
    ribbon(bctx, W * 0.74, W + 10, cyR, H * 0.042, t + 2, gradR, -1, 36, 0);
    ribbon(bctx, -10, W * 0.268, cyL, H * 0.034, t, gradL, 1, 14, floorY);
    ribbon(bctx, W * 0.74, W + 10, cyR, H * 0.036, t + 2, gradR, -1, 14, floorY);
    bctx.globalCompositeOperation = 'source-over';
  }
  const sparkSeeds = (() => { const r = rng(20260923); return Array.from({ length: 140 }, () => [r(), r(), r()]); })();
  function drawSignal(t) {
    const c = sctx;
    c.setTransform(SDPR, 0, 0, SDPR, 0, 0);
    c.clearRect(0, 0, SW, SH);
    c.globalCompositeOperation = 'lighter';
    const cy = SH * 0.52, split = 0.782, ceil = SH * 0.46;
    let peak = 0;
    for (let s = 0; s < 26; s++) {
      const purple = s % 5 === 2, main = s % 5 === 0, dotted = s % 4 === 1, fan = (s - 12.5) / 12.5;
      c.strokeStyle = purple ? gradS2 : gradS1;
      c.fillStyle = c.strokeStyle;
      const ph = s * 0.05, a = SH * (0.19 + 0.03 * Math.sin(s * 1.9));
      c.globalAlpha = dotted ? 0.8 : main ? 0.95 : 0.4;
      c.lineWidth = main ? 1.5 : 0.8;
      if (!dotted) c.beginPath();
      for (let x = 0; x <= SW; x += dotted ? 4 : 2) {
        const u = x / SW;
        const post = u > split ? (u - split) / (1 - split) : 0;
        const amp = a * (1 + post * (0.9 + (s % 3) * 0.4));
        const raw = amp * Math.sin(Math.PI * 2 * 3.1 * u + t * 0.9 + ph) * (0.76 + 0.24 * Math.sin(Math.PI * 2 * 0.8 * u - t * 0.3))
          + fan * SH * 0.11 * Math.sin(Math.PI * 2 * 1.7 * u + t * 0.45 + s * 0.3)
          + post * post * SH * 0.16 * Math.sin(Math.PI * 2 * 4.2 * u + s * 0.7) * (s % 2 ? 1 : -1);
        const y = cy + ceil * Math.tanh(raw / ceil); // soft limiter: post-AI stays under full scale
        peak = Math.max(peak, Math.abs(y - cy) / (SH / 2));
        if (dotted) c.fillRect(x, y, 1.5, 1.5); else x === 0 ? c.moveTo(x, y) : c.lineTo(x, y);
      }
      if (!dotted) {
        c.stroke();
        if (main) { c.globalAlpha = 0.12; c.lineWidth = 5; c.stroke(); }
      }
    }
    for (const [rx, ry, rr] of sparkSeeds) {
      const x = rx * SW, y = cy + (ry - 0.5) * SH * 0.9;
      c.globalAlpha = 0.25 + 0.5 * rr * (0.5 + 0.5 * Math.sin(t * 2 + rr * 20));
      c.fillStyle = rx > split ? '#c07bff' : '#39e6ff';
      c.fillRect(x, y, 1.3, 1.3);
    }
    c.globalAlpha = 1;
    c.globalCompositeOperation = 'source-over';
    return peak;
  }
  function sizeCanvases() {
    DPR = Math.min(1.5, window.devicePixelRatio || 1);
    W = window.innerWidth; H = window.innerHeight;
    bg.width = layer.width = Math.round(W * DPR);
    bg.height = layer.height = Math.round(H * DPR);
    const r = sig.getBoundingClientRect();
    SDPR = Math.min(2, window.devicePixelRatio || 1);
    SW = Math.max(1, Math.round(r.width)); SH = Math.max(1, Math.round(r.height));
    sig.width = Math.round(SW * SDPR); sig.height = Math.round(SH * SDPR);
    paintStatic();
    const mk = (stops) => { const gr = sctx.createLinearGradient(0, 0, SW, 0); stops.forEach(([o, col]) => gr.addColorStop(o, col)); return gr; };
    gradS1 = mk([[0, '#1fe3d2'], [0.3, '#2bd8ff'], [0.6, '#3b8cff'], [0.78, '#6a6bff'], [0.86, '#a24dff'], [1, '#e04bfa']]);
    gradS2 = mk([[0, '#7a4dff'], [0.5, '#9a55ff'], [0.78, '#b04dff'], [1, '#f05bff']]);
    frame(performance.now(), true);
  }

  // Render loop at 30 fps; paused when hidden; single static frame under reduced motion.
  let raf = 0, last = 0, busyMs = 0, windowStart = performance.now(), peakMax = 0;
  function frame(ts, force) {
    const t0 = performance.now();
    const t = reduceMotion.matches ? 0 : ts / 1000;
    drawBg(t);
    peakMax = Math.max(peakMax, drawSignal(t));
    busyMs += performance.now() - t0;
    if (!force && ts - windowStart >= 1000) {
      const cpu = busyMs / (ts - windowStart) * 100;
      if (!REFERENCE) {
        $('tCpu').textContent = cpu.toFixed(1) + '%';
        const overs = Math.max(0, 20 * Math.log10(Math.max(peakMax, 1e-6)));
        $('tClip').textContent = overs.toFixed(1) + 'dB (preview)';
      }
      busyMs = 0; peakMax = 0; windowStart = ts;
    }
  }
  function loop(ts) {
    raf = requestAnimationFrame(loop);
    if (ts - last < 32) return;
    last = ts;
    frame(ts, false);
  }
  function start() { if (!raf && !reduceMotion.matches && !document.hidden) { windowStart = performance.now(); busyMs = 0; raf = requestAnimationFrame(loop); } }
  function stop() { if (raf) cancelAnimationFrame(raf); raf = 0; }
  let resizeQueued = false;
  function queueResize() { if (resizeQueued) return; resizeQueued = true; requestAnimationFrame(() => { resizeQueued = false; sizeCanvases(); }); }
  window.addEventListener('resize', queueResize, { passive: true });
  if ('ResizeObserver' in window) new ResizeObserver(queueResize).observe(sig);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { stop(); clearTimeout(probeTimer); }
    else { start(); if (!REFERENCE) probe(); }
  });
  const onMotionPref = () => { stop(); frame(performance.now(), true); start(); };
  reduceMotion.addEventListener ? reduceMotion.addEventListener('change', onMotionPref) : reduceMotion.addListener(onMotionPref);

  /* ── Boot ───────────────────────────────────────────────────────────────── */
  renderSecurity();
  renderStrength();
  if (!isHttps && !isLocal && !REFERENCE) showAlert('This connection isn’t encrypted. Your password would be sent in plain text; use the https address.', 'warn');

  if (REFERENCE) {
    // QA snapshot of the reference frame. Never transmits anything.
    credEl.value = 'Ernesto';
    passEl.value = '';
    rememberEl.checked = true;
    setReveal(true);
    $('credentialControl').classList.add('ref-focus');
    setState('busy');
    setNet('online');
    net.rtt = 24;
    $('spNode').textContent = 'us-east-1';
    $('spLatency').textContent = '24ms';
    $('spIntegrity').textContent = '99.8%';
    $('tCpu').textContent = '8.4%';
    $('tClip').textContent = '0.0dB';
  } else {
    setNet('checking');
    renderNet();
    probe();
  }
  sizeCanvases();
  start();
})();
