  Reference: ChatGPT_Image_Sep_23__2026__01_31_35_AM.png (1672×940). Geometry is pixel-matched at that viewport.
  QA snapshot of the reference frame: open with  #reference  (no network requests are made in that mode).

  Integration contract (verify against server before shipping):
    POST  CFG.loginUrl          body { [CFG.credentialField]: string, password: string }  → 200 { token, user }
    GET   CFG.healthUrl         any HTTP response = reachable (RTT shown as LATENCY); network error/timeout = OFFLINE
  Override any setting by defining  window.R3_AUTH_CONFIG = { ... }  before this page's script runs.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#050b0c">
<meta name="referrer" content="strict-origin-when-cross-origin">
<!-- Meta CSP: blocks third-party script/font/image loads and exfiltration from the sign-in page.
     frame-ancestors (clickjacking) cannot be set from a meta tag — send it as a response header (helmet). -->
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; font-src data:; img-src data:; connect-src 'self'; form-action 'self'; base-uri 'none'">
<title>Sign in · R3 / NATIVE</title>
<style>
@font-face { font-family: "R3 Mono"; src: url(data:font/woff2;base64,) format("woff2"); font-weight: 100 800; font-style: normal; font-display: block; }
@font-face { font-family: "R3 Display"; src: url(data:font/woff2;base64,) format("woff2"); font-weight: 100 900; font-style: normal; font-display: block; }

:root {
  --bg: #050b0c;
  --ink: #e8eef1;
  --ink-2: #c3cdd3;
  --ink-3: #93a2ab;
  --ink-4: #6a7880;
  --lime: #a4f422;
  --lime-hi: #d2ff5a;
  --lime-lo: #8ee012;
  --lime-ink: #0b1806;
  --green: #3df55c;
  --cyan: #2ee6f2;
  --violet: #a15cff;
  --magenta: #e04bfa;
  --yellow: #f2eb2d;
  --amber: #f5b83d;
  --red: #ff6257;
  --steel: #3a4d5f;
  --line: rgba(255, 255, 255, .085);
  --mono: "R3 Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --display: "R3 Display", Montserrat, "Segoe UI", system-ui, sans-serif;
  --chamfer: 20px;
}

*, *::before, *::after { box-sizing: border-box; }
html { background: var(--bg); -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  min-height: 100vh;
  min-height: 100dvh;
  display: grid;
  grid-template-rows: 56px 1fr auto;
  overflow-x: hidden;
  color: var(--ink);
  font: 400 12px/1.4 var(--mono);
  font-synthesis: none;
  -webkit-font-smoothing: antialiased;
  padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
}
button, input { font: inherit; color: inherit; }
a { color: inherit; }
p { margin: 0; }
svg { flex: 0 0 auto; }
.sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.ico { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
:focus-visible { outline: 2px solid var(--lime-hi); outline-offset: 3px; }

/* ── Background (canvas + reflective floor are painted by script) ─────────── */
#bg { position: fixed; inset: 0; z-index: -2; width: 100%; height: 100%; display: block; }

/* ── Top bar ──────────────────────────────────────────────────────────────── */
.topbar { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; height: 56px; }
.topbar::after { /* hairline with lime glow along the bottom edge */
  content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 1px; pointer-events: none;
  background: linear-gradient(90deg, rgba(164,244,34,.10), rgba(164,244,34,.55) 38%, rgba(164,244,34,.30) 62%, rgba(164,244,34,.08));
}
.tb-panel {
  position: absolute; inset: 0 auto 0 0; width: 697px; display: flex; align-items: center; padding-left: 55px;
  background: linear-gradient(180deg, rgba(4,7,9,.96), rgba(8,13,16,.9));
  clip-path: polygon(0 0, 100% 0, calc(100% - 55px) 100%, 0 100%);
}
.tb-panel::after { /* lit bevel on the diagonal edge */
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(to left bottom, transparent calc(50% - 1px), rgba(170,215,195,.34) 50%, transparent calc(50% + 1.2px)) right / 55px 100% no-repeat;
}
.tb-brand { display: inline-flex; align-items: center; gap: 18px; text-decoration: none; }
.tb-brand .mark { width: 40px; height: 30px; filter: drop-shadow(0 0 6px rgba(164,244,34,.35)); }
.wordmark { font: 660 22.5px/1 var(--display); letter-spacing: .1em; color: #f4f7f8; white-space: nowrap; }
.wordmark b { color: var(--lime); font-weight: 700; margin: 0 .02em; }
.tb-tagline { margin-left: 52px; color: #b6c1c8; font-size: 12px; letter-spacing: .305em; text-transform: uppercase; white-space: nowrap; }
.tb-meta { position: relative; margin: 0 89px 0 auto; display: flex; align-items: center; gap: 18px; color: #93a3ad; font-size: 9.2px; letter-spacing: .165em; text-transform: uppercase; white-space: nowrap; }
.tb-meta .ico { width: 24px; height: 20px; color: var(--lime); stroke-width: 1.8; }
.tb-meta i { font-style: normal; margin: 0 4px; }

/* ── Side furniture ──────────────────────────────────────────────────────── */
.rail {
  position: absolute; top: 96px; left: 53px; z-index: 1; padding: 3px 0 3px 23px;
  border-left: 2px solid var(--lime); color: #aab6bd; font-size: 11.8px; line-height: 20.8px; letter-spacing: .3em; text-transform: uppercase;
}
.rail::before { content: ""; position: absolute; left: -3px; top: 0; bottom: 0; width: 4px; background: rgba(164,244,34,.35); filter: blur(3px); }
.rail strong { color: #f1f5f6; font-weight: 600; }

.status-panel {
  position: absolute; top: 90px; right: 40px; z-index: 1; width: 243px; padding: 0 8px 1px 17px;
  background: linear-gradient(180deg, rgba(5,13,16,.86), rgba(4,10,13,.78));
  border: 1px solid rgba(160,190,200,.13); border-right: 0;
  clip-path: polygon(15px 0, 100% 0, 100% 100%, 0 100%, 0 15px);
}
.status-panel::before { content: ""; position: absolute; left: 0; top: 15px; bottom: 12px; width: 1px; background: linear-gradient(rgba(164,244,34,.4), rgba(164,244,34,.05)); }
.sp-tick { position: absolute; left: 12px; top: 15px; width: 4px; height: 4px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 6px var(--lime); }
.status-panel dl { margin: 0; }
.sp-row { display: flex; align-items: center; justify-content: space-between; height: 34.6px; border-bottom: 1px solid rgba(255,255,255,.07); }
.sp-row:last-child { border-bottom: 0; }
.sp-row dt { display: flex; align-items: center; gap: 13px; color: #a6b5c1; font-size: 10.2px; letter-spacing: .09em; text-transform: uppercase; }
.sp-row dt .ico, .sp-row dt .sp-led-wrap { width: 17px; height: 17px; color: var(--lime); }
.sp-led-wrap { display: grid; place-items: center; }
.sp-led { width: 9px; height: 9px; border-radius: 50%; background: var(--ink-4); box-shadow: 0 0 0 2px rgba(255,255,255,.05); transition: background-color .3s, box-shadow .3s; }
.sp-row dd { margin: 0; color: #eef3f5; font-size: 10.8px; font-weight: 500; letter-spacing: .04em; font-variant-numeric: tabular-nums; }

/* ── Stage & card ────────────────────────────────────────────────────────── */
.stage { position: relative; z-index: 2; display: flex; justify-content: center; align-items: flex-start; padding: 43px 16px 0; min-width: 0; }
.card { position: relative; width: 806px; max-width: 100%; }
.card-glow, .card-edge, .card-surface { clip-path: polygon(var(--chamfer) 0, calc(100% - var(--chamfer)) 0, 100% var(--chamfer), 100% calc(100% - var(--chamfer)), calc(100% - var(--chamfer)) 100%, var(--chamfer) 100%, 0 calc(100% - var(--chamfer)), 0 var(--chamfer)); }
.card-glow { /* static bloom behind the frame; filter lives on a leaf that never repaints */
  position: absolute; inset: -4px; z-index: -1; filter: blur(14px); opacity: 1;
  background: linear-gradient(180deg, rgba(190,255,60,.95), rgba(130,220,40,.34) 20%, rgba(80,160,40,.16) 50%, rgba(120,210,40,.3) 80%, rgba(174,255,52,.8));
}
.card-edge {
  position: absolute; inset: 0; pointer-events: none;
  background:
    linear-gradient(90deg, transparent 2%, rgba(236,255,200,.95) 50%, transparent 98%) top / 100% 1.5px no-repeat,
    linear-gradient(180deg, #b8ff3a 0, #8bd21c 2.5%, #5a6f63 9%, #4b5d6d 30%, #4b5d6d 72%, #5f7a45 91%, #9be823 97.5%, #c8ff55 100%);
}
.card-surface {
  position: absolute; inset: 1.5px; pointer-events: none;
  background:
    radial-gradient(90% 26% at 50% 0%, rgba(150,220,120,.07), transparent 70%),
    linear-gradient(180deg, rgba(20,27,29,.96) 0, rgba(14,20,21,.96) 113px, rgba(9,15,14,.965) 114px, rgba(8,14,13,.965) 100%);
}
.card-surface::before, .card-surface::after { /* faceted glass on the chamfers */
  content: ""; position: absolute; top: 0; width: 60px; height: 60px; opacity: .55;
  background: linear-gradient(135deg, rgba(200,230,215,.16), transparent 45%);
}
.card-surface::before { left: 0; }
.card-surface::after { right: 0; transform: scaleX(-1); }
.card-body { position: relative; }
.card-reflection { /* card glow mirrored on the floor; scrolls with the card */
  position: absolute; left: -2%; right: -2%; top: 100%; height: 84px; pointer-events: none; z-index: -1;
  background:
    radial-gradient(3px 90px at 0.6% 0, rgba(190,255,70,.55), transparent),
    radial-gradient(3px 90px at 99.4% 0, rgba(190,255,70,.55), transparent),
    radial-gradient(9px 120px at 50% 0, rgba(190,255,70,.45), transparent),
    radial-gradient(60% 55px at 50% 0, rgba(164,244,34,.22), transparent);
  filter: blur(2px);
}

/* Header ─ 113px */
.card-head { position: relative; display: flex; align-items: center; height: 113px; padding: 0 49px 0 57px; border-bottom: 1px solid rgba(255,255,255,.075); }
.head-dot { width: 12px; height: 12px; margin-top: 13px; border-radius: 50%; background: radial-gradient(circle at 45% 40%, #fbffc4, #d9ff4a 45%, #9fe51c); box-shadow: 0 0 10px 2px rgba(200,255,60,.75), 0 0 26px 6px rgba(164,244,34,.28); }
.mark-lg { position: relative; width: 53px; height: 40px; margin-left: 40px; margin-top: -9px; filter: drop-shadow(0 0 7px rgba(164,244,34,.45)); }
.mark-dust { position: absolute; left: 112px; top: 79px; width: 46px; height: 3px; opacity: .3; background: radial-gradient(circle, var(--lime) 0 1px, transparent 1.3px) 0 0 / 8px 2px repeat-x; }
.head-title { margin-left: 26px; margin-top: 14px; }
.card-head h1 { margin: 0; font: 640 29.6px/1 var(--display); letter-spacing: .085em; color: #f6f9fa; white-space: nowrap; }
.card-head h1 b { color: var(--lime); font-weight: 700; margin: 0 .03em; }
.subtitle { margin-top: 12px; color: #c6d0d7; font-size: 12.4px; letter-spacing: .325em; text-transform: uppercase; white-space: nowrap; }
.head-meta { margin-left: auto; display: flex; align-items: center; height: 38px; margin-top: 4px; }
.head-div { width: 1px; height: 38px; background: rgba(255,255,255,.14); }
.edition { margin-left: 23px; display: grid; gap: 5px; }
.edition span:first-child { color: #e7edf0; font-size: 10px; letter-spacing: .118em; text-transform: uppercase; white-space: nowrap; }
.edition .ver { color: #9aa8b1; font-size: 10.4px; letter-spacing: .12em; }
.node { margin-left: 32px; display: grid; justify-items: center; gap: 1px; margin-top: 4px; }
.node-k { color: rgba(150,165,172,.55); font-size: 7.2px; letter-spacing: .14em; text-transform: uppercase; }
.node-v { font-size: 9.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--ink-3); transition: color .3s; }
[data-net="online"] .node-v { color: var(--green); text-shadow: 0 0 8px rgba(61,245,92,.35); }
[data-net="degraded"] .node-v { color: var(--amber); }
[data-net="offline"] .node-v { color: var(--red); }

/* Telemetry ─ chips centered at y+139 */
.telemetry { display: flex; align-items: center; gap: 10px; height: 53px; padding: 0 44px 0 44px; }
.chip { display: inline-flex; align-items: center; gap: 12px; height: 27px; padding: 0 14px; border: 1px solid rgba(255,255,255,.105); border-radius: 14px; background: rgba(0,0,0,.34); color: #a2afb8; font-size: 10.3px; letter-spacing: .085em; text-transform: uppercase; white-space: nowrap; }
.chip b { font-weight: 600; color: #f0f4f5; letter-spacing: .04em; font-variant-numeric: tabular-nums; }
.chip b.lime { color: var(--lime); }
.chip-engine { border-color: transparent; background: none; padding: 0 2px 0 0; gap: 8px; font-size: 9.6px; }
.chip-engine .ring { display: grid; place-items: center; width: 27px; height: 27px; border-radius: 50%; border: 1px solid rgba(255,255,255,.12); background: rgba(0,0,0,.3); color: #dfe6ea; }
.chip-engine .ring .ico { width: 15px; height: 15px; }
.chip-gap { flex: 1 1 auto; }
.chip-pair { display: inline-flex; }
.chip-wave { padding: 0 12px; border-radius: 14px 0 0 14px; color: var(--cyan); }
.chip-wave .ico { width: 20px; height: 18px; stroke-width: 1.8; filter: drop-shadow(0 0 4px rgba(46,230,242,.5)); }
.chip-route { margin-left: -1px; border-radius: 0 14px 14px 0; gap: 7px; padding: 0 11px 0 9px; font-size: 9.6px; }
.chip-route .dot { width: 4px; height: 4px; border-radius: 50%; }
.chip-route .pre { background: var(--yellow); box-shadow: 0 0 5px var(--yellow); }
.chip-route .post { background: var(--magenta); box-shadow: 0 0 5px var(--magenta); }
.chip-route .arrow { color: #cfe6ff; margin: 0 5px; font-size: 12px; letter-spacing: 0; }

/* Signal ─ 731×97 at y+166 */
.signal { position: relative; height: 97px; margin: 0 38px 0 37px; border: 1px solid rgba(170,200,215,.2); border-radius: 6px; overflow: hidden;
  background:
    radial-gradient(rgba(110,190,220,.16) .7px, transparent 1.1px) 3px 4px / 9px 9px,
    linear-gradient(90deg, rgba(0,10,20,.9), rgba(0,8,18,.92) 78%, rgba(18,6,34,.92));
  box-shadow: inset 0 0 18px rgba(0,0,0,.6); }
.signal canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.signal-label { position: absolute; left: 12px; top: 9px; color: var(--cyan); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; text-shadow: 0 0 8px rgba(46,230,242,.45); }
.playhead { position: absolute; top: 0; bottom: 0; left: 78.2%; width: 1px; background: #5ffcff; box-shadow: 0 0 6px 1px rgba(51,253,254,.55); }

/* Form */
.form { padding: 0 39px 0 39px; }
.field { margin-top: 25px; }
.field + .field { margin-top: 26px; }
.label { display: flex; align-items: center; gap: 13px; height: 16px; margin: 0 0 7px 13px; color: #e2e9ed; font-size: 11.4px; font-weight: 500; letter-spacing: .125em; text-transform: uppercase; }
.label .ico { width: 17px; height: 17px; color: #dfe6ea; stroke-width: 1.5; }
.label .dim { color: #8594a0; }
.control { position: relative; }
.control input {
  display: block; width: 100%; height: 51px; margin: 0; padding: 0 56px 0 31px;
  border: 1.5px solid #34485c; border-radius: 6px; outline: 0;
  background: linear-gradient(180deg, #17222d, #141e28); color: #e9f0f3; caret-color: var(--lime);
  font: 400 17.2px/1 var(--mono); letter-spacing: .03em;
  transition: border-color .18s ease, box-shadow .18s ease, background-color .18s ease;
}
.control input::placeholder { color: #5f6e79; }
.control input:hover { border-color: #43596e; }
.control input:focus, .control.ref-focus input {
  border-color: #b4ff38;
  background: linear-gradient(180deg, #1c2a2e, #18252a);
  box-shadow: 0 0 0 1px rgba(180,255,56,.22), 0 0 16px rgba(164,244,34,.30), inset 0 0 14px rgba(164,244,34,.05);
}
.control input[aria-invalid="true"] { border-color: var(--red); box-shadow: 0 0 0 1px rgba(255,98,87,.2); }
.caret-bar { position: absolute; left: 16px; top: 17px; width: 1.5px; height: 17px; background: #5b6a74; opacity: 0; transition: opacity .18s; }
.control input:focus + .caret-bar, .control.ref-focus .caret-bar { opacity: .9; }
.control input:-webkit-autofill { -webkit-text-fill-color: #e9f0f3; box-shadow: 0 0 0 40px #17222d inset; }
.reveal { position: absolute; right: 16px; top: 50%; width: 36px; height: 36px; margin-top: -18px; display: grid; place-items: center; border: 0; border-radius: 6px; background: transparent; color: #d7e0e6; cursor: pointer; }
.reveal:hover { color: var(--lime); }
.reveal .ico { width: 21px; height: 21px; stroke-width: 1.6; }
.reveal .eye-off { display: none; }
.reveal[aria-pressed="true"] .eye { display: none; }
.reveal[aria-pressed="true"] .eye-off { display: block; }

/* Strength meter ─ segmented track, continuous level fill (VU style) */
.meter { display: flex; align-items: center; height: 5px; margin: 15px 0 0 4px; }
.meter-track { display: flex; gap: 5px; width: 655px; flex: 0 1 655px; }
.meter-track i { position: relative; height: 5px; border-radius: 3px; background: #242d36; overflow: hidden; }
.meter-track i::after { content: ""; position: absolute; inset: 0; border-radius: inherit; background: var(--meter, var(--lime)); box-shadow: 0 0 8px var(--meter, var(--lime)); transform: scaleX(var(--f, 0)); transform-origin: left; transition: transform .28s ease, background-color .28s; }
.meter-label { margin-left: auto; padding-left: 12px; min-width: 70px; text-align: right; color: var(--meter, var(--lime)); font-size: 10.2px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; white-space: nowrap; }
.meter[data-level="weak"] { --meter: var(--red); }
.meter[data-level="fair"] { --meter: var(--amber); }
.meter[data-level="good"], .meter[data-level="strong"] { --meter: var(--lime); }
.hint, .field-error { margin: 8px 0 0 4px; font-size: 11px; letter-spacing: .04em; }
.hint { color: var(--amber); }
.field-error { color: #ff8a80; }

.row { display: flex; align-items: center; justify-content: space-between; height: 18px; margin: 27px 4px 0 5px; }
.remember { display: inline-flex; align-items: center; gap: 13px; color: #dfe6ea; font-size: 11.6px; letter-spacing: .2em; text-transform: uppercase; cursor: pointer; }
.remember input { appearance: none; -webkit-appearance: none; width: 17px; height: 17px; margin: 0; border: 1.5px solid var(--lime); border-radius: 3px; background: transparent; cursor: pointer; display: grid; place-items: center; box-shadow: 0 0 6px rgba(164,244,34,.25); }
.remember input::after { content: ""; width: 9px; height: 5px; border: solid var(--lime); border-width: 0 0 1.8px 1.8px; transform: translateY(-1px) rotate(-45deg) scale(0); transition: transform .15s ease; }
.remember input:checked::after { transform: translateY(-1px) rotate(-45deg) scale(1); }
.forgot { display: inline-flex; align-items: center; gap: 12px; color: #aab5bd; font-size: 10.5px; letter-spacing: .125em; text-transform: uppercase; text-decoration: none; }
.forgot .ico { width: 12px; height: 12px; stroke-width: 1.8; }
.forgot:hover { color: var(--lime); }

.alert { margin: 16px 4px 0; padding: 10px 14px; border: 1px solid rgba(255,98,87,.4); border-radius: 5px; background: rgba(255,98,87,.07); color: #ffc2bd; font-size: 11.5px; line-height: 1.5; letter-spacing: .02em; }
.alert[data-tone="warn"] { border-color: rgba(245,184,61,.45); background: rgba(245,184,61,.07); color: #ffe2a8; }

.cta {
  position: relative; display: flex; align-items: center; justify-content: center; gap: 0; width: calc(100% - 8px); height: 51px; margin: 24px 4px 0; overflow: hidden;
  border: 0; border-radius: 4px; cursor: pointer; color: var(--lime-ink);
  background: linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,0) 45%), linear-gradient(90deg, #97ec17, #a8f52a 45%, #a2f41f 70%, #9ff21c);
  box-shadow: 0 0 0 1px rgba(210,255,110,.55) inset, 0 0 18px rgba(164,244,34,.38), 0 0 42px rgba(164,244,34,.14);
  font: 700 13.2px/1 var(--mono); letter-spacing: .36em; text-transform: uppercase;
  transition: filter .18s ease, box-shadow .18s ease;
}
.cta .ico { width: 15px; height: 15px; stroke-width: 2.4; margin-right: 38px; }
.cta:hover:not([aria-disabled="true"]) { filter: brightness(1.06); box-shadow: 0 0 0 1px rgba(220,255,130,.7) inset, 0 0 24px rgba(164,244,34,.5), 0 0 54px rgba(164,244,34,.18); }
.cta:focus-visible { outline: 2px solid #f4ffe0; outline-offset: 3px; }
.cta[aria-disabled="true"] { cursor: progress; }
.cta[data-state="busy"]::after { content: ""; position: absolute; top: 0; bottom: 0; left: -30%; width: 22%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.45), transparent); transform: skewX(-18deg); animation: sweep 1.25s ease-in-out infinite; }
.cta[data-state="done"] { background: linear-gradient(90deg, #7ee63a, #9ff05a); }
@keyframes sweep { to { left: 120%; } }

.or { display: flex; align-items: center; gap: 22px; height: 12px; margin: 21px 5px 0; color: var(--ink-3); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; }
.or i { flex: 1; height: 1px; background: rgba(160,180,190,.2); }
.links { display: flex; justify-content: center; align-items: center; gap: 28px; height: 18px; margin-top: 23px; font-size: 12.6px; letter-spacing: .06em; }
.links .muted { color: #aab4bb; margin-right: -1px; }
.links a { text-decoration: none; display: inline-flex; gap: 16px; }
.link-lime { color: var(--lime); font-weight: 600; }
.link-plain { color: #c9d3d9; }
.links a:hover { text-decoration: underline; text-underline-offset: 4px; }

/* Card footer ─ 52px */
.card-foot { position: relative; display: flex; align-items: center; justify-content: space-between; height: 52px; margin-top: 29px; padding: 0 49px 0 49px; border-top: 1px solid rgba(255,255,255,.075); color: #8f9ba4; font-size: 10px; letter-spacing: .22em; text-transform: uppercase; }
.sec { display: inline-flex; align-items: center; gap: 13px; }
.sec .ico { width: 17px; height: 17px; color: #dfe6ea; }
.sec .ico .tick { stroke: var(--lime); stroke-width: 2; }
.sec i { font-style: normal; margin: 0 1.2em; }
.card-foot[data-sec="plain"] .sec { color: var(--amber); }
.card-foot[data-sec="plain"] .sec .ico .tick { stroke: var(--amber); }
.led { position: absolute; left: 50%; top: 50%; width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px; border-radius: 50%; background: var(--ink-4); transition: background-color .3s, box-shadow .3s; }
[data-net="online"] .led, [data-net="online"] .sp-led { background: var(--green); box-shadow: 0 0 8px 1px rgba(61,245,92,.8); }
[data-net="degraded"] .led, [data-net="degraded"] .sp-led { background: var(--amber); box-shadow: 0 0 8px 1px rgba(245,184,61,.7); }
[data-net="offline"] .led, [data-net="offline"] .sp-led { background: var(--red); box-shadow: 0 0 8px 1px rgba(255,98,87,.7); }
.build { letter-spacing: .14em; text-transform: none; }

/* ── Page footer ─────────────────────────────────────────────────────────── */
.page-foot { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 9px 0 36px 55px; }
.pf-brand { display: flex; align-items: center; gap: 19px; }
.pf-brand .ico { width: 30px; height: 30px; color: var(--lime); stroke-width: 2; filter: drop-shadow(0 0 5px rgba(164,244,34,.5)); }
.pf-brand strong { display: block; color: #eef3f5; font-size: 12.6px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
.pf-brand span { display: block; margin-top: 4px; color: #93a0a8; font-size: 9.4px; letter-spacing: .2em; text-transform: uppercase; }
.pf-slogan { display: flex; align-items: center; gap: 16px; color: #aab6bd; font-size: 10.8px; letter-spacing: .3em; text-transform: uppercase; }
.pf-slogan i { width: 42px; height: 1px; background: var(--lime); box-shadow: 0 0 6px var(--lime); }

noscript p { position: fixed; left: 50%; top: 12px; transform: translateX(-50%); z-index: 9; padding: 10px 14px; background: #1a1f22; border: 1px solid var(--amber); color: #ffe2a8; }

/* ── Responsive (reference geometry holds at ≥1420×900) ──────────────────── */
@media (max-width: 1419px) { .status-panel { display: none; } }
@media (max-width: 1179px) { .rail { display: none; } }
