export interface V130CanvasSurface {
  el: HTMLCanvasElement;
  ctx: CanvasRenderingContext2D;
  w: number;
  h: number;
  r: number;
}

export class V130CanvasRegistry {
  readonly surfaces =
    new Set<V130CanvasSurface>();

  add(
    el: HTMLCanvasElement,
    width: number,
    height: number,
    scale: number,
  ): V130CanvasSurface {
    const existing =
      [...this.surfaces].find(
        (surface) =>
          surface.el === el,
      );

    if (existing) {
      this.resize(
        existing,
        width,
        height,
        scale,
      );

      return existing;
    }

    const ctx =
      el.getContext('2d');

    if (!ctx) {
      throw new Error(
        'R3 v1.3 Canvas 2D context unavailable',
      );
    }

    const surface: V130CanvasSurface = {
      el,
      w: Math.max(
        1,
        Math.round(width),
      ),
      h: Math.max(
        1,
        Math.round(height),
      ),
      ctx,
      r: 1,
    };

    this.surfaces.add(
      surface,
    );

    el.style.width =
      `${surface.w}px`;

    el.style.height =
      `${surface.h}px`;

    // Update dimensions from current DOM layout (in case layout changed)
    surface.w = Math.max(1, Math.round(surface.el.clientWidth));
    surface.h = Math.max(1, Math.round(surface.el.clientHeight));

    this.backing(
      surface,
      scale,
    );

    return surface;
  }

  resize(
    surface: V130CanvasSurface,
    width: number,
    height: number,
    scale: number,
  ): boolean {
    const w = Math.max(
      1,
      Math.round(width),
    );

    const h = Math.max(
      1,
      Math.round(height),
    );

    const r = Math.min(
      3,
      Math.max(
        1,
        window.devicePixelRatio ||
          1,
      ) * scale,
    );

    if (
      surface.w === w &&
      surface.h === h &&
      surface.r === r
    ) {
      return false;
    }

    surface.w = w;
    surface.h = h;

    surface.el.style.width =
      `${w}px`;

    surface.el.style.height =
      `${h}px`;

    this.backing(
      surface,
      scale,
    );

    return true;
  }

  sizeCanvases(
    scale: number,
  ): void {
    for (const surface of [
      ...this.surfaces,
    ]) {
      if (
        !surface.el.isConnected
      ) {
        this.surfaces.delete(
          surface,
        );
        continue;
      }

      this.backing(
        surface,
        scale,
      );
    }
  }

  detach(
    el: HTMLCanvasElement,
  ): void {
    for (const surface of [
      ...this.surfaces,
    ]) {
      if (surface.el === el) {
        this.surfaces.delete(
          surface,
        );
      }
    }
  }

  removeDetached(): void {
    for (const surface of [
      ...this.surfaces,
    ]) {
      if (
        !surface.el.isConnected
      ) {
        this.surfaces.delete(
          surface,
        );
      }
    }
  }

  get(
    el: HTMLCanvasElement,
  ):
    | V130CanvasSurface
    | undefined {
    return [...this.surfaces].find(
      (surface) =>
        surface.el === el,
    );
  }

  dispose(): void {
    this.surfaces.clear();
  }

  private backing(
    surface: V130CanvasSurface,
    scale: number,
  ): void {
    const r = Math.min(
      3,
      Math.max(
        1,
        window.devicePixelRatio ||
          1,
      ) * scale,
    );

    surface.el.width =
      Math.max(
        1,
        Math.round(
          surface.w * r,
        ),
      );

    surface.el.height =
      Math.max(
        1,
        Math.round(
          surface.h * r,
        ),
      );

    surface.ctx.setTransform(
      r,
      0,
      0,
      r,
      0,
      0,
    );

    surface.r = r;
  }
}

export function logicalPointer(
  event: PointerEvent,
  surface: V130CanvasSurface,
): { x: number; y: number } {
  const rect =
    surface.el.getBoundingClientRect();

  return {
    x:
      ((event.clientX -
        rect.left) *
        surface.w) /
      Math.max(
        1,
        rect.width,
      ),

    y:
      ((event.clientY -
        rect.top) *
        surface.h) /
      Math.max(
        1,
        rect.height,
      ),
  };
}
