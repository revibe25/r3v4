// 16-step sequencer with per-step velocity and pitch
import { useState, useCallback } from "react";

const T = {
  bg:     "#060606",
  panel:  "#0a0a0a",
  border: "#1c1c1c",
  accent: "#b8ff00",
  dim:    "#555",
  text:   "#f0f0f0",
  font:   "'IBM Plex Mono','JetBrains Mono',monospace",
} as const;

interface Step {
  active:   boolean;
  velocity: number;  // 0–127
  pitch:    number;  // semitone offset
}

interface StepSequencerProps {
  steps?:       number;
  initialSteps?: Step[];
  currentStep?: number;
  disabled?:    boolean;
  onChange?:    (steps: Step[]) => void;
}

const makeSteps = (n: number): Step[] =>
  Array.from({ length: n }, () => ({ active: false, velocity: 100, pitch: 0 }));

export function StepSequencer({
  steps = 16,
  initialSteps,
  currentStep = -1,
  disabled = false,
  onChange,
}: StepSequencerProps) {
  const [state, setState] = useState<Step[]>(initialSteps ?? makeSteps(steps));
  const [length, setLength] = useState(steps);
  const [selected, setSelected] = useState<number | null>(null);

  const toggleStep = useCallback((i: number) => {
    setState(prev => {
      const next = [...prev];
      next[i] = { ...next[i], active: !next[i].active };
      onChange?.(next);
      return next;
    });
  }, [onChange]);

  const updateVelocity = useCallback((i: number, v: number) => {
    setState(prev => {
      const next = [...prev];
      next[i] = { ...next[i], velocity: v };
      onChange?.(next);
      return next;
    });
  }, [onChange]);

  const clearAll = useCallback(() => {
    const next = makeSteps(length);
    setState(next);
    onChange?.(next);
  }, [length, onChange]);

  return (
    <div style={{
      background:    T.bg,
      border:        `1px solid ${T.border}`,
      padding:       12,
      opacity:       disabled ? 0.5 : 1,
      pointerEvents: disabled ? "none" : "auto",
    }}>
      {/* Header */}
      <div style={{
        display:      "flex",
        alignItems:   "center",
        marginBottom: 10,
        gap:          8,
      }}>
        <span style={{
          fontSize:8, letterSpacing:".2em",
          textTransform:"uppercase", color:T.dim,
          fontFamily:T.font,
        }}>Step Sequencer</span>

        {/* Length selector */}
        <div style={{ display:"flex", gap:2, marginLeft:"auto" }}>
          {[8,16,32].map(n => (
            <button key={n} onClick={() => {
              setLength(n);
              setState(prev => {
                const next = Array.from({ length: n }, (_, i) =>
                  prev[i] ?? { active: false, velocity: 100, pitch: 0 }
                );
                onChange?.(next);
                return next;
              });
            }} style={{
              height:        18,
              padding:       "0 8px",
              background:    length === n ? T.accent : "transparent",
              border:        `1px solid ${length === n ? T.accent : T.border}`,
              color:         length === n ? "#000" : T.dim,
              fontFamily:    T.font,
              fontSize:      8,
              cursor:        "pointer",
            }}>{n}</button>
          ))}
        </div>

        <button onClick={clearAll} style={{
          height:     18, padding:"0 8px",
          background: "transparent",
          border:     `1px solid ${T.border}`,
          color:      T.dim, fontFamily:T.font,
          fontSize:   8, cursor:"pointer",
          letterSpacing:".1em",
        }}>CLR</button>
      </div>

      {/* Step buttons */}
      <div style={{
        display:             "grid",
        gridTemplateColumns: `repeat(${Math.min(length, 16)}, 1fr)`,
        gap:                 2,
        marginBottom:        8,
      }}>
        {state.slice(0, length).map((step, i) => {
          const isCurrent = i === currentStep;
          const groupStart = i % 4 === 0;
          return (
            <button
              key={i}
              onClick={() => { toggleStep(i); setSelected(i); }}
              style={{
                height:        step.active ? 32 : 28,
                background:    isCurrent
                  ? T.accent
                  : step.active
                    ? `rgba(184,255,0,${0.3 + (step.velocity / 127) * 0.5})`
                    : T.panel,
                border:        `1px solid ${
                  isCurrent ? T.accent
                  : step.active ? T.accent
                  : groupStart ? T.dim : T.border
                }`,
                borderRadius:  0,
                cursor:        "pointer",
                transition:    "all .06s",
                outline:       selected === i ? `1px solid ${T.accent}` : "none",
                outlineOffset: 1,
              }}
            />
          );
        })}
      </div>

      {/* Velocity editor for selected step */}
      {selected !== null && selected < state.length && (
        <div style={{
          padding:      8,
          background:   T.panel,
          border:       `1px solid ${T.border}`,
          display:      "flex",
          alignItems:   "center",
          gap:          10,
        }}>
          <span style={{
            fontSize:7, letterSpacing:".15em",
            textTransform:"uppercase", color:T.dim,
            fontFamily:T.font, flexShrink:0,
          }}>Step {selected + 1} — VEL</span>
          <input
            type="range" min={1} max={127}
            value={state[selected]?.velocity ?? 100}
            onChange={e => updateVelocity(selected, parseInt(e.target.value))}
            style={{ flex:1, accentColor:T.accent }}
          />
          <span style={{
            fontSize:9, color:T.text, fontFamily:T.font,
            width:24, textAlign:"right", flexShrink:0,
          }}>{state[selected]?.velocity ?? 100}</span>
        </div>
      )}
    </div>
  );
}
'

