// Canvas-based timeline/arrangement view
import { useRef, useEffect, useState, useCallback } from "react";
import type { ArrangementTrack, ArrangementMarker } from "../../../../shared/arrangement.types";

const T = {
  bg:       "#060606",
  panel:    "#0a0a0a",
  border:   "#1c1c1c",
  accent:   "#b8ff00",
  dim:      "#555",
  text:     "#f0f0f0",
  grid:     "rgba(255,255,255,0.04)",
  font:     "'IBM Plex Mono','JetBrains Mono',monospace",
} as const;

const HEADER_H = 28;
const TRACK_H  = 72;
const RULER_H  = 24;
const LABEL_W  = 160;
const PX_PER_BAR = 80;

interface ArrangementViewProps {
  tracks:        ArrangementTrack[];
  playheadBar:   number;
  loopStart:     number;
  loopEnd:       number;
  loopEnabled:   boolean;
  totalBars:     number;
  markers:       ArrangementMarker[];
  onPlayheadSeek:(bar: number) => void;
  onTrackSelect: (id: string) => void;
  selectedTrack: string | null;
}

export function ArrangementView({
  tracks, playheadBar, loopStart, loopEnd, loopEnabled,
  totalBars, markers, onPlayheadSeek, onTrackSelect, selectedTrack
}: ArrangementViewProps) {
  const rulerRef    = useRef<HTMLCanvasElement>(null);
  const timelineRef = useRef<HTMLCanvasElement>(null);
  const [scrollX, setScrollX]   = useState(0);
  const [zoom, setZoom]         = useState(1);
  const pxPerBar = PX_PER_BAR * zoom;
  const totalW   = totalBars * pxPerBar;

  // Draw ruler
  useEffect(() => {
    const canvas = rulerRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = T.panel;
    ctx.fillRect(0, 0, w, h);

    ctx.font = `8px ${T.font}`;
    ctx.fillStyle = T.dim;
    ctx.textAlign = "center";

    const startBar = Math.floor(scrollX / pxPerBar);
    const endBar   = Math.ceil((scrollX + w) / pxPerBar) + 1;

    for (let bar = startBar; bar <= Math.min(endBar, totalBars); bar++) {
      const x = bar * pxPerBar - scrollX;
      ctx.strokeStyle = bar % 4 === 0 ? T.dim : T.grid;
      ctx.lineWidth   = bar % 4 === 0 ? 0.5 : 0.3;
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
      if (bar % 2 === 0) {
        ctx.fillStyle = T.dim;
        ctx.fillText(String(bar + 1), x, h - 4);
      }
    }

    // Loop region
    if (loopEnabled) {
      const lx = loopStart * pxPerBar - scrollX;
      const lw = (loopEnd - loopStart) * pxPerBar;
      ctx.fillStyle = "rgba(184,255,0,0.08)";
      ctx.fillRect(lx, 0, lw, h);
      ctx.strokeStyle = T.accent;
      ctx.lineWidth = 1;
      ctx.strokeRect(lx, 0, lw, h);
    }

    // Markers
    markers.forEach(m => {
      const mx = m.position * pxPerBar - scrollX;
      ctx.fillStyle = m.color ?? T.accent;
      ctx.beginPath();
      ctx.moveTo(mx, 0);
      ctx.lineTo(mx + 6, 0);
      ctx.lineTo(mx, 8);
      ctx.closePath();
      ctx.fill();
    });

    // Playhead
    const ph = playheadBar * pxPerBar - scrollX;
    ctx.strokeStyle = T.accent;
    ctx.lineWidth   = 1.5;
    ctx.beginPath();
    ctx.moveTo(ph, 0);
    ctx.lineTo(ph, h);
    ctx.stroke();
  }, [scrollX, zoom, playheadBar, loopStart, loopEnd, loopEnabled, totalBars, markers, pxPerBar]);

  // Draw timeline regions
  useEffect(() => {
    const canvas = timelineRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    tracks.forEach((track, trackIdx) => {
      const ty = trackIdx * TRACK_H;

      // Track row background
      ctx.fillStyle = trackIdx % 2 === 0 ? T.bg : "rgba(255,255,255,0.01)";
      ctx.fillRect(0, ty, w, TRACK_H);

      // Grid lines
      const startBar = Math.floor(scrollX / pxPerBar);
      const endBar   = Math.ceil((scrollX + w) / pxPerBar) + 1;
      for (let bar = startBar; bar <= endBar; bar++) {
        const x = bar * pxPerBar - scrollX;
        ctx.strokeStyle = bar % 4 === 0 ? T.border : T.grid;
        ctx.lineWidth   = 0.5;
        ctx.beginPath();
        ctx.moveTo(x, ty);
        ctx.lineTo(x, ty + TRACK_H);
        ctx.stroke();
      }

      // Regions
      track.regions.forEach(region => {
        const rx = (region as any).startBar * pxPerBar - scrollX;
        const rw = (region as any).length * pxPerBar;
        if (rx + rw < 0 || rx > w) return;

        const color = track.color ?? T.accent;
        ctx.fillStyle = `${color}33`;
        ctx.fillRect(rx, ty + 4, rw - 1, TRACK_H - 8);
        ctx.strokeStyle = color;
        ctx.lineWidth = 1;
        ctx.strokeRect(rx, ty + 4, rw - 1, TRACK_H - 8);

        ctx.fillStyle = color;
        ctx.font      = `8px ${T.font}`;
        ctx.textAlign = "left";
        if (rw > 20) ctx.fillText((region as any).name ?? "", rx + 4, ty + 16);
      });

      // Track separator
      ctx.strokeStyle = T.border;
      ctx.lineWidth   = 0.5;
      ctx.beginPath();
      ctx.moveTo(0, ty + TRACK_H);
      ctx.lineTo(w, ty + TRACK_H);
      ctx.stroke();
    });

    // Playhead line
    const ph = playheadBar * pxPerBar - scrollX;
    ctx.strokeStyle = T.accent;
    ctx.lineWidth   = 1.5;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(ph, 0);
    ctx.lineTo(ph, h);
    ctx.stroke();
    ctx.setLineDash([]);
  }, [tracks, scrollX, zoom, playheadBar, pxPerBar]);

  const handleRulerClick = useCallback((e: React.MouseEvent<HTMLCanvasElement>) => {
    const rect = e.currentTarget.getBoundingClientRect();
    const x    = e.clientX - rect.left + scrollX;
    onPlayheadSeek(x / pxPerBar);
  }, [scrollX, pxPerBar, onPlayheadSeek]);

  const canvasW = Math.max(totalW, 800);
  const canvasH = tracks.length * TRACK_H;

  return (
    <div style={{
