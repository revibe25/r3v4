#!/usr/bin/env bash
# ============================================================================
#  r3upgrade — R3 v4 DAW Enhancement Implementation Script
#  Implements all new components from R3-v4-DAW-Roadmap.md
#  Phases 1–4: Server fix, Transport, Mixer, Effects, Arrangement, MIDI
#
#  Usage:
#    bash r3upgrade              — run all phases
#    bash r3upgrade --phase 1    — run specific phase only
#    bash r3upgrade --dry        — preview without writing files
# ============================================================================
set -euo pipefail

GRN=$'\033[0;32m'; RED=$'\033[0;31m'; YLW=$'\033[0;33m'
CYN=$'\033[0;36m'; BLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'

ok()      { echo "${GRN}✓${RST} $*"; }
fail()    { echo "${RED}✗${RST} $*"; FAILURES=$((FAILURES+1)); }
warn()    { echo "${YLW}⚠${RST}  $*"; }
info()    { echo "${CYN}→${RST} $*"; }
section() { echo ""; echo "${BLD}${CYN}══ $* ══════════════════════════════════════${RST}"; echo ""; }
created() { echo "${GRN}+${RST} Created: $*"; }

FAILURES=0
ROOT="${1:-$PWD}"
DRY="${DRY:-false}"
PHASE="${PHASE:-all}"

# Parse flags
for arg in "$@"; do
  case "$arg" in
    --dry)   DRY=true ;;
    --phase) shift; PHASE="${1:-all}" ;;
  esac
done

write_file() {
  local path="$1"
  local content="$2"
  if [[ "$DRY" == "true" ]]; then
    info "DRY: would write $path"
    return
  fi
  mkdir -p "$(dirname "$path")"
  echo "$content" > "$path"
  created "$path"
}

echo ""
echo "${BLD}${CYN}╔══════════════════════════════════════════════════════╗${RST}"
echo "${BLD}${CYN}║  R3 v4 · DAW Enhancement Implementation Runner      ║${RST}"
echo "${BLD}${CYN}╚══════════════════════════════════════════════════════╝${RST}"
echo "${DIM}  Root  : $ROOT${RST}"
echo "${DIM}  Phase : $PHASE${RST}"
echo "${DIM}  Dry   : $DRY${RST}"
echo ""

# ============================================================================
# PHASE 1 — SERVER STABILITY
# ============================================================================
if [[ "$PHASE" == "all" || "$PHASE" == "1" ]]; then
section "Phase 1 — Server Stability"

info "Fixing .ts extension in llpte-core re-exports..."

# Fix dj/index.ts
DJ_IDX="$ROOT/packages/llpte-core/src/dj/index.ts"
if [[ -f "$DJ_IDX" ]]; then
  if grep -q '\.ts"' "$DJ_IDX" 2>/dev/null; then
    [[ "$DRY" == "false" ]] && sed -i 's|from "\./DJEngine\.ts"|from "./DJEngine"|g' "$DJ_IDX"
    ok "Fixed .ts extension in dj/index.ts"
  else
    ok "dj/index.ts already clean"
  fi
else
  fail "dj/index.ts not found"
fi

# Fix mixer/index.ts
MX_IDX="$ROOT/packages/llpte-core/src/mixer/index.ts"
if [[ -f "$MX_IDX" ]]; then
  if grep -q '\.ts"' "$MX_IDX" 2>/dev/null; then
    [[ "$DRY" == "false" ]] && sed -i 's|from "\./MixerEngine\.ts"|from "./MixerEngine"|g' "$MX_IDX"
    ok "Fixed .ts extension in mixer/index.ts"
  else
    ok "mixer/index.ts already clean"
  fi
else
  fail "mixer/index.ts not found"
fi

# Fix ALL other index.ts files in llpte-core that have .ts extensions
info "Scanning all llpte-core index files for .ts extensions..."
find "$ROOT/packages/llpte-core/src" -name "index.ts" | while IFS= read -r f; do
  if grep -q 'from "\./.*\.ts"' "$f" 2>/dev/null; then
    [[ "$DRY" == "false" ]] && \
      perl -i -pe 's|from "(\.\/[^"]+)\.ts"|from "$1"|g' "$f"
    ok "Fixed: $f"
  fi
done

# Build llpte-core
info "Building llpte-core..."
if [[ "$DRY" == "false" ]]; then
  cd "$ROOT/packages/llpte-core"
  if pnpm build 2>&1 | tee /tmp/llpte-build.log | grep -q "error TS"; then
    fail "llpte-core build failed — check /tmp/llpte-build.log"
    cat /tmp/llpte-build.log | grep "error TS" | head -10
  else
    ok "llpte-core built successfully"
  fi
  cd "$ROOT"
fi

# Update exports map to dist
info "Updating package.json exports to dist/..."
cat > /tmp/fix-exports.py << 'PYEOF'
import json, sys
path = sys.argv[1]
with open(path) as f:
    pkg = json.load(f)
pkg["exports"] = {
    ".":             {"types": "./dist/index.d.ts",             "default": "./dist/index.js"},
    "./types":       {"types": "./dist/types/index.d.ts",       "default": "./dist/types/index.js"},
    "./engine":      {"types": "./dist/engine/index.d.ts",      "default": "./dist/engine/index.js"},
    "./mixer":       {"types": "./dist/mixer/index.d.ts",       "default": "./dist/mixer/index.js"},
    "./dj":          {"types": "./dist/dj/index.d.ts",          "default": "./dist/dj/index.js"},
    "./effects":     {"types": "./dist/effects/index.d.ts",     "default": "./dist/effects/index.js"},
    "./arrangement": {"types": "./dist/arrangement/index.d.ts", "default": "./dist/arrangement/index.js"},
}
with open(path, "w") as f:
    json.dump(pkg, f, indent=2)
    f.write("\n")
print("exports map updated to dist/")
PYEOF

PKG_JSON="$ROOT/packages/llpte-core/package.json"
if [[ "$DRY" == "false" ]]; then
  python3 /tmp/fix-exports.py "$PKG_JSON" && ok "exports map updated"
fi

fi # end phase 1

