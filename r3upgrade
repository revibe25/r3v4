// 3-band parametric EQ with visual curve
import { useState, useRef, useEffect, useCallback } from "react";

const T = {
  bg:     "#0a0a0a",
  border: "#1c1c1c",
  accent: "#b8ff00",
  dim:    "#555",
  text:   "#f0f0f0",
  font:   "'IBM Plex Mono','JetBrains Mono',monospace",
} as const;

interface EQBand {
  freq: number;   // Hz
  gain: number;   // dB (-12 to +12)
  q:    number;   // 0.1 to 10
  type: "lowshelf" | "peaking" | "highshelf";
}

interface EQPanelProps {
  bands?:    EQBand[];
  onChange?: (bands: EQBand[]) => void;
  disabled?: boolean;
}

const DEFAULT_BANDS: EQBand[] = [
  { freq: 100,  gain: 0, q: 0.7, type: "lowshelf"  },
  { freq: 1000, gain: 0, q: 1.0, type: "peaking"   },
  { freq: 8000, gain: 0, q: 0.7, type: "highshelf" },
];

function Knob({ label, value, min, max, step = 0.1, unit = "", onChange }: {
  label: string; value: number; min: number; max: number;
  step?: number; unit?: string; onChange: (v: number) => void;
}) {
  const norm = (value - min) / (max - min);
  const angle = norm * 270 - 135;
  return (
    <div style={{ display:"flex", flexDirection:"column", alignItems:"center", gap:3, minWidth:44 }}>
      <span style={{ fontSize:7, letterSpacing:".15em", textTransform:"uppercase", color:T.dim }}>{label}</span>
      <div style={{ position:"relative", width:32, height:32 }}>
        <div style={{
          position:"absolute", inset:0, borderRadius:"50%",
          background:"#111", border:`1px solid ${T.border}`,
        }} />
        <div style={{
          position:"absolute", top:"50%", left:"50%",
          width:2, height:12, background:T.accent, borderRadius:1,
          transform:`translate(-50%,-100%) rotate(${angle}deg)`,
          transformOrigin:"bottom center",
          transition:"transform .05s",
        }} />
        <input
          type="range" min={min} max={max} step={step} value={value}
          onChange={e => onChange(parseFloat(e.target.value))}
          style={{
            position:"absolute", inset:0, opacity:0,
            cursor:"pointer", width:"100%", height:"100%",
            WebkitAppearance:"none",
          } as React.CSSProperties}
        />
      </div>
      <span style={{ fontSize:8, color:T.text, fontFamily:T.font, letterSpacing:".05em" }}>
        {value.toFixed(step < 1 ? 1 : 0)}{unit}
      </span>
    </div>
  );
}

export function EQPanel({ bands = DEFAULT_BANDS, onChange, disabled = false }: EQPanelProps) {
  const [state, setState] = useState<EQBand[]>(bands);
  const canvasRef = useRef<HTMLCanvasElement>(null);

  const update = useCallback((i: number, patch: Partial<EQBand>) => {
    setState(prev => {
      const next = prev.map((b, idx) => idx === i ? { ...b, ...patch } : b);
      onChange?.(next);
      return next;
    });
  }, [onChange]);

  // Draw EQ curve
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const { width: w, height: h } = canvas;
    ctx.clearRect(0, 0, w, h);
    ctx.strokeStyle = T.accent;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    for (let x = 0; x < w; x++) {
      const freq = 20 * Math.pow(1000, x / w);
      let totalGain = 0;
      state.forEach(band => {
        const ratio = freq / band.freq;
        const logRatio = Math.log2(ratio);
        totalGain += band.gain * Math.exp(-logRatio * logRatio * band.q);
      });
      const y = h / 2 - (totalGain / 12) * (h / 2 - 4);
      x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.stroke();
    // Center line
    ctx.strokeStyle = T.border;
    ctx.lineWidth = 0.5;
    ctx.beginPath();
    ctx.moveTo(0, h / 2);
    ctx.lineTo(w, h / 2);
    ctx.stroke();
  }, [state]);

  const bandLabels = ["LOW", "MID", "HIGH"];
  const bandColors = [T.accent, "#00e5ff", "#ff6b35"];

  return (
    <div style={{
      background: T.bg,
      border:     `1px solid ${T.border}`,
      padding:    12,
      opacity:    disabled ? 0.5 : 1,
      pointerEvents: disabled ? "none" : "auto",
    }}>
      {/* EQ Curve */}
      <canvas
        ref={canvasRef}
        width={280}
        height={60}
        style={{ width:"100%", height:60, display:"block", marginBottom:12 }}
      />
      {/* Bands */}
      <div style={{ display:"flex", justifyContent:"space-around" }}>
        {state.map((band, i) => (
          <div key={i} style={{
            display:"flex", flexDirection:"column", alignItems:"center", gap:6,
            padding:"8px 6px",
            borderLeft: i > 0 ? `1px solid ${T.border}` : "none",
            flex: 1,
          }}>
            <span style={{
              fontSize:7, letterSpacing:".2em", textTransform:"uppercase",
              color: bandColors[i], fontFamily: T.font,
            }}>{bandLabels[i]}</span>
            <Knob label="FREQ" value={band.freq}
              min={i===0?20:i===1?200:2000}
              max={i===0?500:i===1?5000:20000}
              step={i===0?1:i===1?10:100}
              unit="Hz"
              onChange={v => update(i, { freq: v })} />
            <Knob label="GAIN" value={band.gain} min={-12} max={12} step={0.5} unit="dB"
              onChange={v => update(i, { gain: v })} />
            {band.type === "peaking" && (
              <Knob label="Q" value={band.q} min={0.1} max={10} step={0.1}
                onChange={v => update(i, { q: v })} />
            )}
          </div>
        ))}
      </div>
    </div>
  );
}
