// Canvas-based MIDI piano roll editor
import { useRef, useEffect, useState, useCallback } from "react";
import type { MidiNote } from "../../../../shared/midi.types";
import { midiNoteToName, MIDI_PPQ } from "../../../../shared/midi.types";

const T = {
  bg:      "#060606",
  panel:   "#0a0a0a",
  border:  "#1c1c1c",
  accent:  "#b8ff00",
  dim:     "#555",
  text:    "#f0f0f0",
  white:   "#1a1a1a",
  black:   "#0d0d0d",
  grid:    "rgba(255,255,255,0.04)",
  font:    "'IBM Plex Mono','JetBrains Mono',monospace",
} as const;

const NOTE_H    = 10;
const PIANO_W   = 48;
const PX_PER_TICK = 0.1;
const TOTAL_NOTES = 128;

interface PianoRollProps {
  notes?:       MidiNote[];
  lengthTicks?: number;
  ppq?:         number;
  onChange?:    (notes: MidiNote[]) => void;
  disabled?:    boolean;
}

export function PianoRoll({
  notes = [], lengthTicks = MIDI_PPQ * 4 * 16,
  ppq = MIDI_PPQ, onChange, disabled = false
}: PianoRollProps) {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const [state, setState]   = useState<MidiNote[]>(notes);
  const [tool, setTool]     = useState<"draw" | "select" | "erase">("draw");
  const [scrollY, setScrollY] = useState((60) * NOTE_H);  // start near middle C
  const [scrollX, setScrollX] = useState(0);

  const isBlack = (pitch: number) => [1,3,6,8,10].includes(pitch % 12);
  const totalW  = lengthTicks * PX_PER_TICK;
  const totalH  = TOTAL_NOTES * NOTE_H;

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    // Background rows
    for (let pitch = 0; pitch < TOTAL_NOTES; pitch++) {
      const y = (TOTAL_NOTES - 1 - pitch) * NOTE_H - scrollY;
      if (y + NOTE_H < 0 || y > h) continue;
      ctx.fillStyle = isBlack(pitch) ? T.black : T.bg;
      ctx.fillRect(0, y, w, NOTE_H);
      // Row separator
      ctx.strokeStyle = T.border;
      ctx.lineWidth   = 0.3;
      ctx.beginPath();
      ctx.moveTo(0, y + NOTE_H);
      ctx.lineTo(w, y + NOTE_H);
      ctx.stroke();
    }

    // Vertical grid (beats)
    const ticksPerBeat = ppq;
    const startTick = Math.floor(scrollX / PX_PER_TICK);
    const endTick   = startTick + w / PX_PER_TICK;
    for (let tick = 0; tick <= endTick; tick += ticksPerBeat / 4) {
      const x = tick * PX_PER_TICK - scrollX;
      ctx.strokeStyle = tick % (ticksPerBeat * 4) === 0
        ? T.dim
        : tick % ticksPerBeat === 0
          ? T.border
          : T.grid;
      ctx.lineWidth   = tick % (ticksPerBeat * 4) === 0 ? 0.8 : 0.3;
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }

    // Notes
    state.forEach(note => {
      const x = note.startTick * PX_PER_TICK - scrollX;
      const y = (TOTAL_NOTES - 1 - note.pitch) * NOTE_H - scrollY;
      const w2 = Math.max(2, note.duration * PX_PER_TICK);
      if (x + w2 < 0 || x > w || y + NOTE_H < 0 || y > h) return;
      const velAlpha = 0.4 + (note.velocity / 127) * 0.6;
      ctx.fillStyle   = `rgba(184,255,0,${velAlpha})`;
      ctx.strokeStyle = T.accent;
      ctx.lineWidth   = 0.5;
      ctx.fillRect(x, y + 1, w2 - 1, NOTE_H - 2);
      ctx.strokeRect(x, y + 1, w2 - 1, NOTE_H - 2);
    });
  }, [state, scrollX, scrollY, ppq]);

  const handleCanvasClick = useCallback((e: React.MouseEvent<HTMLCanvasElement>) => {
    if (disabled) return;
    const rect  = e.currentTarget.getBoundingClientRect();
    const x     = e.clientX - rect.left + scrollX;
    const y     = e.clientY - rect.top  + scrollY;
    const tick  = Math.floor(x / PX_PER_TICK / (ppq / 4)) * (ppq / 4);
    const pitch = TOTAL_NOTES - 1 - Math.floor(y / NOTE_H);
    if (pitch < 0 || pitch > 127) return;

    if (tool === "draw") {
      const newNote: MidiNote = {
        id:        `n_${Date.now()}`,
        pitch,
        velocity:  100,
        startTick: tick,
        duration:  ppq / 4,
        channel:   0,
      };
      const next = [...state, newNote];
      setState(next);
      onChange?.(next);
    } else if (tool === "erase") {
      const next = state.filter(n => {
        const nx = n.startTick * PX_PER_TICK;
        const ny = (TOTAL_NOTES - 1 - n.pitch) * NOTE_H;
        const nw = n.duration * PX_PER_TICK;
        return !(x >= nx && x <= nx + nw && y >= ny && y <= ny + NOTE_H);
      });
      setState(next);
      onChange?.(next);
    }
  }, [disabled, scrollX, scrollY, state, tool, ppq, onChange]);

  return (
    <div style={{
      display:       "flex",
      flexDirection: "column",
      background:    T.bg,
      border:        `1px solid ${T.border}`,
      overflow:      "hidden",
      opacity:       disabled ? 0.5 : 1,
    }}>
      {/* Toolbar */}
      <div style={{
        display:      "flex",
        gap:          4,
        padding:      "4px 8px",
        borderBottom: `1px solid ${T.border}`,
        background:   T.panel,
      }}>
        {(["draw","select","erase"] as const).map(t => (
          <button key={t} onClick={() => setTool(t)} style={{
            height:        22,
            padding:       "0 10px",
            background:    tool === t ? T.accent : "transparent",
            border:        `1px solid ${tool === t ? T.accent : T.border}`,
            color:         tool === t ? "#000" : T.dim,
            fontFamily:    T.font,
            fontSize:      8,
            letterSpacing: ".15em",
            textTransform: "uppercase",
            cursor:        "pointer",
          }}>{t}</button>
        ))}
        <span style={{
          marginLeft:"auto", fontSize:8, color:T.dim,
          fontFamily:T.font, letterSpacing:".1em",
          alignSelf:"center",
        }}>
          {state.length} notes
        </span>
      </div>

      {/* Piano + Roll */}
      <div style={{ display:"flex", flex:1, overflow:"hidden", minHeight:200 }}>
        {/* Mini piano */}
        <div style={{
          width:PIANO_W, flexShrink:0,
          borderRight:`1px solid ${T.border}`,
          overflow:"hidden", position:"relative",
        }}>
          <div style={{
            position:"absolute",
            top: -scrollY,
            left:0, right:0,
          }}>
            {Array.from({ length: TOTAL_NOTES }).map((_, i) => {
              const pitch = TOTAL_NOTES - 1 - i;
              const black = isBlack(pitch);
              const isC   = pitch % 12 === 0;
              return (
                <div key={i} style={{
                  height:      NOTE_H,
                  background:  black ? "#111" : "#1e1e1e",
                  borderBottom:`1px solid ${T.border}`,
                  display:     "flex",
                  alignItems:  "center",
                  justifyContent:"flex-end",
                  paddingRight:4,
                }}>
                  {isC && (
                    <span style={{
                      fontSize:6, color:T.dim,
                      fontFamily:T.font,
                    }}>{midiNoteToName(pitch)}</span>
                  )}
                </div>
              );
            })}
          </div>
        </div>

        {/* Roll canvas */}
        <div
          style={{ flex:1, overflow:"auto",
            scrollbarWidth:"thin", scrollbarColor:`${T.accent} ${T.bg}` }}
          onScroll={e => {
            setScrollX((e.target as HTMLDivElement).scrollLeft);
            setScrollY((e.target as HTMLDivElement).scrollTop);
          }}
        >
          <canvas
            ref={canvasRef}
            width={Math.max(totalW, 800)}
            height={totalH}
            onClick={handleCanvasClick}
            style={{ display:"block", cursor: tool === "draw" ? "crosshair" : tool === "erase" ? "cell" : "default" }}
          />
        </div>
      </div>
    </div>
  );
}
'

