write_file "$ROOT/client/src/components/transport-bar.tsx" '// client/src/components/transport-bar.tsx
// Canonical Transport Bar — Play/Pause/Stop/Record/BPM/Position/Loop
// Wired to useAudioEngine hook. Matches R3 lime design system.
import { useState, useCallback, useEffect } from "react";
import {
  Play, Square, Circle, SkipBack, Repeat,
  Mic, Metronome
} from "lucide-react";

const T = {
  bg:        "#060606",
  panel:     "#0a0a0a",
  border:    "#1c1c1c",
  accent:    "#b8ff00",
  accentDim: "rgba(184,255,0,0.12)",
  text:      "#f0f0f0",
  dim:       "#555",
  danger:    "#ff3b3b",
  record:    "#ff3b3b",
  font:      "'IBM Plex Mono','JetBrains Mono',monospace",
} as const;

interface TransportBarProps {
  isPlaying:    boolean;
  isRecording:  boolean;
  isArmed:      boolean;
  bpm:          number;
  position:     { bar: number; beat: number; tick: number };
  loopEnabled:  boolean;
  metronomeOn:  boolean;
  disabled:     boolean;
  onPlay:       () => void;
  onStop:       () => void;
  onRecord:     () => void;
  onArm:        () => void;
  onRewind:     () => void;
  onBpmChange:  (bpm: number) => void;
  onLoopToggle: () => void;
  onMetronome:  () => void;
}

function TBtn({
  onClick, active = false, danger = false, disabled = false,
  title, children
}: {
  onClick: () => void; active?: boolean; danger?: boolean;
  disabled?: boolean; title?: string; children: React.ReactNode;
}) {
  return (
    <button
      onClick={onClick}
      disabled={disabled}
      title={title}
      style={{
        display:        "flex",
        alignItems:     "center",
        justifyContent: "center",
        width:          32,
        height:         28,
        background:     active
          ? (danger ? T.danger : T.accentDim)
          : "transparent",
        border:         `1px solid ${active ? (danger ? T.danger : T.accent) : T.border}`,
        borderRadius:   0,
        color:          active
          ? (danger ? "#fff" : T.accent)
          : T.dim,
        cursor:         disabled ? "not-allowed" : "pointer",
        opacity:        disabled ? 0.4 : 1,
        transition:     "all .1s",
        flexShrink:     0,
        fontFamily:     T.font,
      }}
      onMouseEnter={e => {
        if (disabled || active) return;
        e.currentTarget.style.background  = danger ? "rgba(255,59,59,0.1)" : T.accentDim;
        e.currentTarget.style.borderColor = danger ? T.danger : T.accent;
        e.currentTarget.style.color       = danger ? T.danger : T.accent;
      }}
      onMouseLeave={e => {
        if (disabled || active) return;
        e.currentTarget.style.background  = "transparent";
        e.currentTarget.style.borderColor = T.border;
        e.currentTarget.style.color       = T.dim;
      }}
    >
      {children}
    </button>
  );
}

export function TransportBar({
  isPlaying, isRecording, isArmed, bpm, position,
  loopEnabled, metronomeOn, disabled,
  onPlay, onStop, onRecord, onArm, onRewind,
  onBpmChange, onLoopToggle, onMetronome,
}: TransportBarProps) {
  const [bpmInput, setBpmInput] = useState(String(bpm));
  const [editingBpm, setEditingBpm] = useState(false);

  useEffect(() => {
    if (!editingBpm) setBpmInput(String(bpm));
  }, [bpm, editingBpm]);

  const commitBpm = useCallback(() => {
    const val = parseFloat(bpmInput);
    if (!isNaN(val) && val >= 20 && val <= 999) {
      onBpmChange(Math.round(val * 10) / 10);
    } else {
      setBpmInput(String(bpm));
    }
    setEditingBpm(false);
  }, [bpmInput, bpm, onBpmChange]);

  const posStr = `${String(position.bar).padStart(3,"0")} : ${position.beat} : ${String(position.tick).padStart(3,"0")}`;

  return (
    <div style={{
      display:     "flex",
      alignItems:  "center",
      gap:         8,
      height:      36,
      padding:     "0 12px",
      background:  T.panel,
      borderBottom:`1px solid ${T.border}`,
      fontFamily:  T.font,
      flexShrink:  0,
      overflowX:   "auto",
    }}>
      {/* Rewind */}
      <TBtn onClick={onRewind} disabled={disabled} title="Rewind to start">
        <SkipBack size={12} />
      </TBtn>

      {/* Play/Pause */}
      <TBtn onClick={onPlay} active={isPlaying} disabled={disabled} title={isPlaying ? "Pause" : "Play"}>
        <Play size={12} />
      </TBtn>

      {/* Stop */}
      <TBtn onClick={onStop} disabled={disabled} title="Stop">
        <Square size={12} />
      </TBtn>

      {/* Arm */}
      <TBtn onClick={onArm} active={isArmed} danger disabled={disabled} title="Arm for recording">
        <Mic size={12} />
      </TBtn>

      {/* Record */}
      <TBtn onClick={onRecord} active={isRecording} danger disabled={!isArmed || disabled} title="Record">
        <Circle size={12} style={{ fill: isRecording ? T.record : "none" }} />
      </TBtn>

      <div style={{ width: 1, height: 20, background: T.border, flexShrink: 0 }} />

      {/* Loop */}
      <TBtn onClick={onLoopToggle} active={loopEnabled} disabled={disabled} title="Loop">
        <Repeat size={12} />
      </TBtn>

      {/* Metronome */}
      <TBtn onClick={onMetronome} active={metronomeOn} disabled={disabled} title="Metronome">
        <span style={{ fontSize: 10, fontWeight: 700 }}>♩</span>
      </TBtn>

      <div style={{ width: 1, height: 20, background: T.border, flexShrink: 0 }} />

      {/* Position counter */}
      <div style={{
        padding:     "0 10px",
        height:      24,
        display:     "flex",
        alignItems:  "center",
        background:  T.bg,
        border:      `1px solid ${T.border}`,
        color:       T.accent,
        fontSize:    11,
        letterSpacing: ".08em",
        fontVariantNumeric: "tabular-nums",
        minWidth:    120,
        flexShrink:  0,
      }}>
        {posStr}
      </div>

      <div style={{ width: 1, height: 20, background: T.border, flexShrink: 0 }} />

      {/* BPM */}
      <div style={{ display: "flex", alignItems: "center", gap: 6, flexShrink: 0 }}>
        <span style={{ fontSize: 8, letterSpacing: ".2em", color: T.dim, textTransform: "uppercase" }}>
          BPM
        </span>
        {editingBpm ? (
          <input
            autoFocus
            value={bpmInput}
            onChange={e => setBpmInput(e.target.value)}
            onBlur={commitBpm}
            onKeyDown={e => { if (e.key === "Enter") commitBpm(); if (e.key === "Escape") setEditingBpm(false); }}
            style={{
              width:       52,
              height:      24,
              background:  T.bg,
              border:      `1px solid ${T.accent}`,
              color:       T.accent,
              fontFamily:  T.font,
              fontSize:    13,
              textAlign:   "center",
              outline:     "none",
              padding:     0,
            }}
          />
        ) : (
          <button
            onClick={() => !disabled && setEditingBpm(true)}
            style={{
              width:       52,
              height:      24,
              background:  T.bg,
              border:      `1px solid ${T.border}`,
              color:       T.text,
              fontFamily:  T.font,
              fontSize:    13,
              textAlign:   "center",
              cursor:      disabled ? "default" : "pointer",
              padding:     0,
            }}
          >
            {bpm}
          </button>
        )}
      </div>
    </div>
  );
}
'

ok "transport-bar.tsx created"
fi # end phase 3

