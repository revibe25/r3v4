/**
 * App.tsx — Router configuration with Auth integration
 * 
 * STEPS TO INTEGRATE:
 * 1. Copy authService.ts to src/services/
 * 2. Copy useAuth.ts to src/hooks/
 * 3. Copy ProtectedRoute.tsx to src/components/
 * 4. Replace your App.tsx with this code
 * 5. Update imports based on your actual file structure
 * 6. Run: pnpm dev
 */

import React, { Suspense } from 'react';
import { BrowserRouter as Router, Routes, Route, Navigate } from 'react-router-dom';
import { AuthProvider } from './hooks/useAuth';
import { ProtectedRoute } from './components/ProtectedRoute';

// Auth page (loaded as static HTML)
import AuthPage from './pages/auth';

// Lazy load your app pages
const InstrumentPage = React.lazy(() => import('./pages/instrument'));
const DashboardPage = React.lazy(() => import('./pages/dashboard'));
const NotFoundPage = React.lazy(() => import('./pages/not-found'));

/**
 * LoadingFallback — Shown while routes are loading
 */
const LoadingFallback = () => (
  <div className="flex items-center justify-center h-screen bg-gray-900 text-white">
    <div className="text-center">
      <div className="animate-spin mb-4">⏳</div>
      <p>Loading...</p>
    </div>
  </div>
);

/**
 * Layout wrapper for authenticated pages
 */
const AppLayout: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div className="min-h-screen bg-gray-900 text-white">
    {/* Add nav bar here if needed */}
    <main>{children}</main>
  </div>
);

/**
 * Main App component with routes
 */
function App() {
  return (
    <Router>
      <AuthProvider>
        <Routes>
          {/* Public routes */}
          <Route path="/auth.html" element={<AuthPage />} />
          <Route path="/auth" element={<AuthPage />} />

          {/* Protected routes */}
          <Route
            path="/instrument"
            element={
              <ProtectedRoute>
                <AppLayout>
                  <Suspense fallback={<LoadingFallback />}>
                    <InstrumentPage />
                  </Suspense>
                </AppLayout>
              </ProtectedRoute>
            }
          />

          <Route
            path="/dashboard"
            element={
              <ProtectedRoute>
                <AppLayout>
                  <Suspense fallback={<LoadingFallback />}>
                    <DashboardPage />
                  </Suspense>
                </AppLayout>
              </ProtectedRoute>
            }
          />

          {/* Catch-all */}
          <Route
            path="/"
            element={
              <Navigate to="/instrument" replace />
            }
          />
          <Route
            path="*"
            element={
              <Suspense fallback={<LoadingFallback />}>
                <NotFoundPage />
              </Suspense>
            }
          />
        </Routes>
      </AuthProvider>
    </Router>
  );
}

export default App;
