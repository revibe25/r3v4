{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "isolatedModules": false,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@shared/*": [
        "./shared/*"
      ],
      "@llpte/llpte-signal": [
        "../llpte-signal/dist/index"
      ]
    }
  },
  "references": [
    {
      "path": "../../shared"
    },
    {
      "path": "../llpte-signal"
    },
    {
      "path": "../llpte-core"
    }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
