{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@llpte/*": [
        "../../packages/*/src"
      ],
      "@shared/*": [
        "../../shared/src"
      ]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "references": [
    {
      "path": "../../shared"
    }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
