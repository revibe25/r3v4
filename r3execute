#!/usr/bin/env bash
# ============================================================================
#  r3execute — R3 v4 Directive Execution & Audit Runner
#  Audits current project state against the R3 v4 Engineering Directive.
#  Executes safe automated fixes (e.g. maxHeight destructure, dead files).
#
#  Usage:
#    bash r3execute           — audit only
#    bash r3execute . --clean — audit + remove dead .bak files
# ============================================================================
set -euo pipefail

GRN=$'\033[0;32m'; RED=$'\033[0;31m'; YLW=$'\033[0;33m'
CYN=$'\033[0;36m'; BLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'

ok()      { echo "${GRN}✓${RST} $*"; }
fail()    { echo "${RED}✗${RST} $*"; FAILURES=$((FAILURES+1)); }
warn()    { echo "${YLW}⚠${RST}  $*"; WARNINGS=$((WARNINGS+1)); }
info()    { echo "${CYN}→${RST} $*"; }
fixed()   { echo "${GRN}⚡${RST} AUTO-FIXED: $*"; }
section() {
  echo ""
  echo "${BLD}${CYN}── $* ──────────────────────────────────────${RST}"
}

FAILURES=0
WARNINGS=0
ROOT="${1:-$PWD}"
DB_URL="${DATABASE_URL:-}"
if [[ -z "$DB_URL" ]]; then
  echo "ERROR: DATABASE_URL is not set. Export it before running this script."
  exit 1
fi

echo ""
echo "${BLD}${CYN}╔══════════════════════════════════════════════════════╗${RST}"
echo "${BLD}${CYN}║  R3 v4 · Directive Execution & Audit Runner         ║${RST}"
echo "${BLD}${CYN}╚══════════════════════════════════════════════╝${RST}"
echo "${DIM}  Root   : $ROOT${RST}"
echo "${DIM}  DB     : DATABASE_URL set${RST}"
echo "${DIM}  Mode   : ${2:-audit only}${RST}"
echo ""

# ── Helper: check a key exists and isn't a placeholder ──────────────────────
check_env() {
  local file="$1" key="$2"
  if [[ ! -f "$file" ]]; then
    fail "$key — file not found: $file"
    return
  fi
  if grep -q "^${key}=" "$file" 2>/dev/null; then
    local val
    val=$(grep "^${key}=" "$file" | cut -d= -f2-)
    if [[ -z "$val" ]] \
    || [[ "$val" == *"your_"* ]] \
    || [[ "$val" == *"replace"* ]] \
    || [[ "$val" == *"example"* ]] \
    || [[ "$val" == *"CHANGE_ME"* ]]; then
      warn "$key has placeholder/weak value in $(basename "$file")"
    else
      ok "$key present in $(basename "$file")"
    fi
  else
    fail "$key MISSING from $(basename "$file")"
  fi
}

# ── Helper: grep check with explicit ok/fail (avoids && ok || fail pitfall) ──
grep_check() {
  local file="$1" pattern="$2" ok_msg="$3" fail_msg="$4"
  if [[ ! -f "$file" ]]; then
    fail "$fail_msg (file not found: $(basename "$file"))"
    return
  fi
  if grep -q "$pattern" "$file" 2>/dev/null; then
    ok "$ok_msg"
  else
    fail "$fail_msg"
  fi
}

# ============================================================================
# SECTION 1 — ENVIRONMENT CONTRACT
# ============================================================================
section "1. Environment Contract"

info "Checking server/.env..."
for key in JWT_SECRET DATABASE_URL SESSION_SECRET; do
  check_env "$ROOT/server/.env" "$key"
done

info "Checking root .env..."
for key in STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET DATABASE_URL SESSION_SECRET; do
  check_env "$ROOT/.env" "$key"
done

# JWT_SECRET length check
JWT_VAL=$(grep "^JWT_SECRET=" "$ROOT/server/.env" 2>/dev/null | cut -d= -f2- || echo "")
if [[ ${#JWT_VAL} -ge 64 ]]; then
  ok "JWT_SECRET length: ${#JWT_VAL} chars (>=64 required)"
else
  fail "JWT_SECRET too short: ${#JWT_VAL} chars — need >=64"
fi

# SESSION_SECRET strength check
SESSION_VAL=$(grep "^SESSION_SECRET=" "$ROOT/server/.env" 2>/dev/null | cut -d= -f2- || echo "")
if [[ "$SESSION_VAL" == "supersecret" ]]; then
  fail "SESSION_SECRET is 'supersecret' — CRITICAL SECURITY RISK"
elif [[ ${#SESSION_VAL} -ge 64 ]]; then
  ok "SESSION_SECRET hardened (${#SESSION_VAL} chars)"
elif [[ ${#SESSION_VAL} -ge 32 ]]; then
  ok "SESSION_SECRET adequate (${#SESSION_VAL} chars)"
else
  warn "SESSION_SECRET weak (${#SESSION_VAL} chars — recommend >=64)"
fi

# Startup validation guard in server/config.ts
grep_check \
  "$ROOT/server/config.ts" \
  "JWT_SECRET\|DATABASE_URL\|throw\|Missing" \
  "server/config.ts has startup env validation" \
  "server/config.ts missing startup env validation guard"

# ============================================================================
# SECTION 2 — AUTH STORE INTEGRITY
# ============================================================================
section "2. Auth Store Integrity"

CANONICAL_STORE="$ROOT/client/src/stores/authStore.ts"
DEAD_STORE_1="$ROOT/client/src/store/auth-store.ts"
DEAD_STORE_2="$ROOT/client/src/store/authStore.ts"

[[ -f "$CANONICAL_STORE" ]] \
  && ok "Canonical store exists: client/src/stores/authStore.ts" \
  || fail "Canonical store MISSING: client/src/stores/authStore.ts"

[[ ! -f "$DEAD_STORE_1" ]] \
  && ok "Dead store absent: store/auth-store.ts" \
  || fail "Dead store still exists — DELETE: store/auth-store.ts"

[[ ! -f "$DEAD_STORE_2" ]] \
  && ok "Dead store absent: store/authStore.ts" \
  || fail "Dead store still exists — DELETE: store/authStore.ts"

grep_check \
  "$CANONICAL_STORE" \
  "isAuthenticated: state.isAuthenticated" \
  "isAuthenticated persisted in partialize (survives reload)" \
  "isAuthenticated NOT in partialize — auth state lost on reload"

grep_check \
  "$CANONICAL_STORE" \
  "hydrateFromToken" \
  "hydrateFromToken present in store" \
  "hydrateFromToken missing from canonical store"

# Dead import sweep
DEAD_IMPORT_COUNT=$(grep -rn "store/auth-store" \
  "$ROOT/client/src" \
  --include="*.ts" --include="*.tsx" 2>/dev/null | wc -l | tr -d '[:space:]' || echo 0)
if [[ "$DEAD_IMPORT_COUNT" -eq 0 ]]; then
  ok "Zero dead imports to store/auth-store"
else
  fail "$DEAD_IMPORT_COUNT dead import(s) to store/auth-store still present:"
  grep -rn "store/auth-store" "$ROOT/client/src" \
    --include="*.ts" --include="*.tsx" 2>/dev/null || true
fi

# ============================================================================
# SECTION 3 — DATABASE & SUBSCRIPTION
# ============================================================================
section "3. Database & Subscription"

info "Testing PostgreSQL connection..."
if psql "$DB_URL" -c "SELECT 1;" &>/dev/null 2>&1; then
  ok "PostgreSQL connection successful"
else
  warn "Cannot connect to PostgreSQL — skipping all DB checks"
  warn "Ensure server is running and DB_URL is correct"
fi

# rest of file omitted for brevity; unchanged logic continues
